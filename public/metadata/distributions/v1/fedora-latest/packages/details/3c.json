      "id": "3ceba736f106179bca91",
      "name": "perl-Hardware-Vhdl-Lexer",
      "epoch": "0",
      "version": "1.00",
      "release": "49.fc44",
      "architecture": "noarch",
      "summary": "Split VHDL code into lexical tokens",
      "description": "Hardware::Vhdl::Lexer splits VHDL code into lexical tokens. To use it, you\nneed to first create a lexer object, passing in something which will supply\nchunks of VHDL code to the lexer. Repeated calls to the get_next_token\nmethod of the lexer will then return VHDL tokens (in scalar context) or a\ntoken type code and the token (in list context). get_next_token returns\nundef when there are no more tokens to be read.",
      "homepage": "https://metacpan.org/release/Hardware-Vhdl-Lexer",
      "license": "GPL-1.0-or-later OR Artistic-1.0-Perl",
