    {
      "id": "7cc9dfcd05ebbe09b50e",
      "name": "gfs-bodoni-classic-fonts",
      "epoch": "0",
      "version": "20070415",
      "release": "49.fc44",
      "architecture": "noarch",
      "summary": "GFS Bodoni Classic, an 18th century oblique Greek font family",
      "description": "Giambattista Bodoni was the most prolific Italian type cutter of the 18th\ncentury. While he worked in the Vatican Press he was involved in the\ntype cutting of “exotic” languages for which catholic literature was printed.\nWhen he established his own press in Parma he did publish many books of the\nclassics with his own Greek typefaces in the last quarter of the 18th century.\nHe was among the first European type cutters to move away from the byzantine\ncursive tradition with the numerous ligatures which was the norm until then.\nHis Greek types influenced many subsequent designers, yet they fell in disuse\nby the middle of the 19th century.\n\nGFS presented Bodoni’s original Greek typeface in the commemorative edition of\nPindar’s Olympian Odes (2004), in digital version by George D. Matthiopoulos,\nand is now available as free ware for the general public. In the OpenType\nfeatures, under ligatures, one may alternately use diphthongs with the accents\nplaced in between the characters, as Giambattista Bodoni did when setting\nGreek texts.",
      "homepage": "http://www.greekfontsociety-gfs.gr/typefaces/18th_century",
      "license": "OFL-1.1",
      "sourcePackage": "gfs-bodoni-classic-fonts-20070415-49.fc44.src.rpm",
      "repository": "fedora",
      "installedSize": 103058,
      "downloadSize": 57293,
      "dependencies": {
        "requires": [
          "fontpackages-filesystem"
        ],
