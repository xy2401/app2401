      "name": "up-imapproxy",
      "epoch": "0",
      "version": "1.2.8",
      "release": "0.34.20250101svn15036.fc44",
      "architecture": "amd64",
      "summary": "University of Pittsburgh IMAP Proxy",
      "description": "imapproxy was written to compensate for webmail clients that are\nunable to maintain persistent connections to an IMAP server. Most\nwebmail clients need to log in to an IMAP server for nearly every\nsingle transaction. This behaviour can cause tragic performance\nproblems on the IMAP server. imapproxy tries to deal with this problem\nby leaving server connections open for a short time after a webmail\nclient logs out. When the webmail client connects again, imapproxy\nwill determine if there's a cached connection available and reuse it\nif possible.",
      "homepage": "http://www.imapproxy.org",
