{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-source-atlas.example/schemas/distribution-index-v1.schema.json",
  "title": "Linux distribution static metadata index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "revision",
    "distributions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$"
    },
    "distributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "canonicalId",
          "label",
          "distribution",
          "image",
          "packageCount",
          "groupCount",
          "environmentCount",
          "collectionCount",
          "curatedPackageCount",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "canonicalId": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "label": {
            "type": "string"
          },
          "distribution": {
            "type": "object"
          },
          "image": {
            "type": "object"
          },
          "packageCount": {
            "type": "integer",
            "minimum": 0
          },
          "groupCount": {
            "type": "integer",
            "minimum": 0
          },
          "environmentCount": {
            "type": "integer",
            "minimum": 0
          },
          "collectionCount": {
            "type": "integer",
            "minimum": 0
          },
          "curatedPackageCount": {
            "type": "integer",
            "minimum": 0
          },
          "files": {
            "type": "object"
          }
        }
      }
    }
  }
}
