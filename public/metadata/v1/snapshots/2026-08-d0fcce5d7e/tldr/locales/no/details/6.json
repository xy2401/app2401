      "id": "tldr--b7063bf74894",
      "canonicalPath": "common/ack.md",
      "locale": "no",
      "sourceLocale": "no",
      "name": "ack",
      "title": "ack",
      "summary": "Et søkeverktøy som grep, optimalisert for utviklere. Se også: `rg`.",
      "platform": "cross-platform",
      "softwareIds": [
        "ack--bef95259"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Søk etter filer som inneholder en streng eller regulært uttrykk i gjeldende katalog rekursivt:",
          "command": "ack \"{{søkemønster}}\"",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L9"
        },
        {
          "description": "Søk etter et mønster som ikke skiller mellom store og små bokstaver:",
          "command": "ack {{[-i|--ignore-case]}} \"{{søkemønster}}\"",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L13"
        },
        {
          "description": "Søk etter linjer som samsvarer med et mønster, skriv ut bare den samsvarende teksten og ikke resten av linjen:",
          "command": "ack {{[-o|--output '$&']}} \"{{søkemønster}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L17"
        },
        {
          "description": "Begrens søket til filer av en bestemt type:",
          "command": "ack {{[-t|--type]}} {{ruby}} \"{{søkemønster}}\"",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L21"
        },
        {
          "description": "Ikke søk i filer av en bestemt type:",
          "command": "ack {{[-t|--type]}} no{{ruby}} \"{{søkemønster}}\"",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L25"
        },
        {
          "description": "Tell totalt antall treff funnet:",
          "command": "ack {{[-c|--count]}} {{[-h|--no-filename]}} \"{{søkemønster}}\"",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L29"
        },
        {
          "description": "Skriv ut filnavnene og antall treff kun for hver fil:",
          "command": "ack {{[-c|--count]}} {{[-l|--files-with-matches]}} \"{{søkemønster}}\"",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L33"
        },
        {
          "description": "List opp alle verdiene som kan brukes med `--type`:",
          "command": "ack --help-types",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.no/common/ack.md#L37"
        }
      ],
