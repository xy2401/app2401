        },
        {
          "description": "Čitaj datoteku sve do `<Ctrl c>`:",
          "command": "tail {{[-f|--follow]}} {{datoteka}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bs/common/tail.md#L21"
        },
