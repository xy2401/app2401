      "id": "tldr--6f84dee948da",
      "canonicalPath": "common/rm.md",
      "locale": "nb",
      "sourceLocale": "nb",
      "name": "rm",
      "title": "rm",
      "summary": "Fjern filer eller mapper. Se også: `rmdir`, `trash`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Fjern bestemte filer:",
          "command": "rm {{sti/til/fil1 sti/til/fil2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/rm.md#L9"
        },
        {
          "description": "Fjern bestemte filer og ignorer dem som ikke finnes:",
          "command": "rm {{[-f|--force]}} {{sti/til/fil1 sti/til/fil2 ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/rm.md#L13"
        },
        {
          "description": "Fjern bestemte filer interaktivt med spørsmål før hver fjerning:",
          "command": "rm {{[-i|--interactive]}} {{sti/til/fil1 sti/til/fil2 ...}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/rm.md#L17"
        },
        {
          "description": "Fjern bestemte filer og skriv ut informasjon om hver fjerning:",
          "command": "rm {{[-v|--verbose]}} {{sti/til/fil1 sti/til/fil2 ...}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/rm.md#L21"
        },
        {
          "description": "Fjern bestemte filer og mapper rekursivt:",
          "command": "rm {{[-r|--recursive]}} {{sti/til/fil_eller_mappe1 sti/til/fil_eller_mappe2 ...}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/rm.md#L25"
        },
        {
          "description": "Fjern tomme mapper (dette regnes som den trygge metoden):",
          "command": "rm {{[-d|--dir]}} {{sti/til/mappe}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/rm.md#L29"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/rm.md"
