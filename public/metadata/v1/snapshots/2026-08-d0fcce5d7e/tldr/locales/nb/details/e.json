    {
      "id": "tldr--c2fe16eaac9d",
      "canonicalPath": "common/cp.md",
      "locale": "nb",
      "sourceLocale": "nb",
      "name": "cp",
      "title": "cp",
      "summary": "Kopier filer og mapper.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Kopier en fil til et annet sted:",
          "command": "cp {{sti/til/kildefil}} {{sti/til/målfil}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L8"
        },
        {
          "description": "Kopier en fil til en annen mappe, og behold filnavnet:",
          "command": "cp {{sti/til/kildefil}} {{sti/til/overordnet_målmappe}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L12"
        },
        {
          "description": "Kopier innholdet i en mappe rekursivt til et annet sted (hvis målet finnes, kopieres mappen inn i det):",
          "command": "cp {{[-r|--recursive]}} {{sti/til/kildemappe}} {{sti/til/målmappe}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L16"
        },
        {
          "description": "Kopier en mappe rekursivt, i detaljert modus (viser filer etter hvert som de kopieres):",
          "command": "cp {{[-vr|--verbose --recursive]}} {{sti/til/kildemappe}} {{sti/til/målmappe}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L20"
        },
        {
          "description": "Kopier flere filer samtidig til en mappe:",
          "command": "cp {{[-t|--target-directory]}} {{sti/til/målmappe}} {{sti/til/fil1 sti/til/fil2 ...}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L24"
        },
        {
          "description": "Kopier alle filer med en bestemt filendelse til et annet sted, i interaktiv modus (spør brukeren før overskriving):",
          "command": "cp {{[-i|--interactive]}} {{*.ext}} {{sti/til/målmappe}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L28"
        },
        {
          "description": "Følg symbolske lenker før kopiering:",
          "command": "cp {{[-L|--dereference]}} {{lenke}} {{sti/til/målmappe}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L32"
        },
        {
          "description": "Bruk hele stien til kildefilene, og opprett eventuelle manglende mellomliggende mapper ved kopiering:",
          "command": "cp --parents {{kilde/sti/til/fil}} {{sti/til/målfil}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.nb/common/cp.md"
    },
