      "canonicalPath": "sunos/share.md",
      "locale": "ro",
      "sourceLocale": "ro",
      "name": "share",
      "title": "share",
      "summary": "Face disponibilă o resursă locală sau un sistem de fișiere pentru a fi montat de către sisteme la distanță.",
      "platform": "sunos",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "Listează toate sistemele de fișiere partajate curent:",
          "command": "share",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/sunos/share.md#L8"
        },
        {
          "description": "Partajează un director cu acces de citire/scriere:",
          "command": "share -F nfs -o rw /{{cale/către/director}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/sunos/share.md#L12"
        },
        {
          "description": "Partajează un director cu acces doar pentru citire:",
          "command": "share -F nfs -o ro /{{cale/către/director}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/sunos/share.md#L16"
        },
        {
          "description": "Partajează un director cu opțiuni specifice (ex. permite acces root de la o gazdă specifică):",
          "command": "share -F nfs -o rw,root={{nume_gazdă}} /{{cale/către/director}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/sunos/share.md#L20"
        },
        {
          "description": "Face partajarea persistentă prin adăugarea intrărilor în `/etc/dfs/dfstab`:",
          "command": "echo \"share -F nfs -o rw /{{cale/către/director}}\" >> /etc/dfs/dfstab",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/sunos/share.md#L24"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/sunos/share.md"
