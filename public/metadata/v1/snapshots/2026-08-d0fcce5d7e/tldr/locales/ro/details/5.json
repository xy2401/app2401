      "id": "tldr--6f84dee948da",
      "canonicalPath": "common/rm.md",
      "locale": "ro",
      "sourceLocale": "ro",
      "name": "rm",
      "title": "rm",
      "summary": "Șterge fișiere sau foldere. Vezi și: `rmdir`, `trash`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Șterge fișiere specifice:",
          "command": "rm {{cale/către/fișier1 cale/către/fișier2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/rm.md#L9"
        },
        {
          "description": "Șterge fișiere specifice ignorând cele care nu există:",
          "command": "rm {{[-f|--force]}} {{cale/către/fișier1 cale/către/fișier2 ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/rm.md#L13"
        },
        {
          "description": "Șterge fișiere specifice cerând confirmare interactiv înainte de fiecare ștergere:",
          "command": "rm {{[-i|--interactive]}} {{cale/către/fișier1 cale/către/fișier2 ...}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/rm.md#L17"
        },
        {
          "description": "Șterge fișiere specifice afișând informații despre fiecare ștergere:",
          "command": "rm {{[-v|--verbose]}} {{cale/către/fișier1 cale/către/fișier2 ...}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/rm.md#L21"
        },
        {
          "description": "Șterge recursiv fișiere și foldere specifice:",
          "command": "rm {{[-r|--recursive]}} {{cale/către/fișier_sau_folder1 cale/către/fișier_sau_folder2 ...}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/rm.md#L25"
        },
        {
          "description": "Șterge folderele goale (aceasta este considerată metoda sigură):",
          "command": "rm {{[-d|--dir]}} {{cale/către/folder}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/rm.md#L29"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/rm.md"
