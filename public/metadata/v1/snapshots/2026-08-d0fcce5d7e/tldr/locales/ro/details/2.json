      "id": "tldr--6506fc95a9e3",
      "canonicalPath": "common/todoist.md",
      "locale": "ro",
      "sourceLocale": "ro",
      "name": "todoist",
      "title": "todoist",
      "summary": "Acest program îți permite să folosești Todoist din linia de comandă.",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Adaugă o sarcină:",
          "command": "todoist {{[a|add]}} \"{{o_sarcină}}\"",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/todoist.md#L8"
        },
        {
          "description": "Adaugă o sarcină cu prioritate ridicată cu o etichetă, proiect și dată scadentă:",
          "command": "todoist {{[a|add]}} \"{{o_sarcină}}\" --priority {{1}} --label-ids \"{{idul_etichetei}}\" --project-name \"{{numele_proiectului}}\" --date \"{{tmr 9am}}\"",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/todoist.md#L12"
        },
        {
          "description": "Adaugă o sarcină cu prioritate ridicată cu o etichetă, proiect și dată scadentă, folosind modul rapid:",
          "command": "todoist {{[q|quick]}} '#{{numele_proiectului}} \"{{tmr 9am}}\" p{{1}} {{o_sarcină}} @{{numele_etichetei}}'",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/todoist.md#L16"
        },
        {
          "description": "Enumeră toate sarcinile cu cap de tabel și culori:",
          "command": "todoist --header --color list",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/todoist.md#L20"
        },
        {
          "description": "Enumeră toate sarcinile cu prioritate ridicată:",
          "command": "todoist {{[l|list]}} --filter p{{1}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/todoist.md#L24"
        },
        {
          "description": "Enumeră toate sarcinile cu prioritate ridicată de astăzi care au eticheta specificată:",
          "command": "todoist {{[l|list]}} --filter '(@{{numele_etichetei}} | {{today}}) & p{{1}}'",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/todoist.md#L28"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/todoist.md"
