    {
      "id": "tldr--42489738ab06",
      "canonicalPath": "common/grep.md",
      "locale": "ro",
      "sourceLocale": "ro",
      "name": "grep",
      "title": "grep",
      "summary": "Caută tipare în fișiere folosind expresii regulate (`regex`). Vezi și: `rg`, `regex`.",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "grep--aeeff087",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Caută un tipar într-un set de fișiere:",
          "command": "grep \"{{tipar_de_căutare}}\" {{cale/către/fișier1 cale/către/fișier2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L9"
        },
        {
          "description": "Caută un șir de caractere exact (dezactivează `regex`-ul):",
          "command": "grep {{[-F|--fixed-strings]}} \"{{șir_exact}}\" {{cale/către/fișier}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L13"
        },
        {
          "description": "Caută un tipar recursiv în toate fișierele dintr-un folder, ignorând fișierele binare:",
          "command": "grep {{[-rI|--recursive --binary-files=without-match]}} \"{{tipar_de_căutare}}\" {{cale/către/folder}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L17"
        },
        {
          "description": "Afișează 3 linii de [C]ontext (în jur, î[B]ainte sau [A]fter de fiecare potrivire):",
          "command": "grep {{--context|--before-context|--after-context}} 3 \"{{tipar_de_căutare}}\" {{cale/către/fișier}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L21"
        },
        {
          "description": "Afișează numele fișierului și numărul liniei pentru fiecare potrivire, cu ieșire colorată:",
          "command": "grep {{[-Hn|--with-filename --line-number]}} --color=always \"{{tipar_de_căutare}}\" {{cale/către/fișier}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L25"
        },
        {
          "description": "Afișează doar textul potrivit:",
          "command": "grep {{[-o|--only-matching]}} \"{{tipar_de_căutare}}\" {{cale/către/fișier}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L29"
        },
        {
          "description": "Citește datele din `stdin` și nu afișează liniile care se potrivesc cu tiparul:",
          "command": "cat {{cale/către/fișier}} | grep {{[-v|--invert-match]}} \"{{tipar_de_căutare}}\"",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L33"
        },
        {
          "description": "Folosește `regex` extins (suportă `?`, `+`, `{}`, `()` și `|`), în mod insensibil la majuscule:",
          "command": "grep {{[-Ei|--extended-regexp --ignore-case]}} \"{{tipar_de_căutare}}\" {{cale/către/fișier}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/grep.md"
    },
