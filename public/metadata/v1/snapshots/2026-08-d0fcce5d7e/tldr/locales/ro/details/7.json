      ],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "Afișează conținutul unui fișier la `stdout`:",
          "command": "cat {{cale/către/fișier}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/cat.md#L8"
        },
        {
          "description": "Concatenează mai multe fișiere într-un fișier de ieșire:",
