    {
      "id": "tldr--d2d461722f29",
      "canonicalPath": "common/ssh.md",
      "locale": "ro",
      "sourceLocale": "ro",
      "name": "ssh",
      "title": "ssh",
      "summary": "Secure Shell este un protocol folosit pentru a te conecta în siguranță la sisteme la distanță. Poate fi folosit pentru autentificare sau pentru a rula comenzi pe un server la distanță.",
      "platform": "cross-platform",
      "softwareIds": [
        "git-with-openssh--49faf317",
        "gow--4cb149e7",
        "mina-sshd--7d588911",
        "mls-software-openssh--6b012d8a",
        "openssh--7291a89e"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Conectare la un server la distanță:",
          "command": "ssh {{nume_utilizator}}@{{server_distant}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L9"
        },
        {
          "description": "Conectare la un server la distanță cu o [i]dentitate specifică (cheie privată):",
          "command": "ssh {{nume_utilizator}}@{{server_distant}} -i {{cale/către/fișier_cheie}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L13"
        },
        {
          "description": "Conectare la un server la distanță cu IP-ul `10.0.0.1` folosind un [p]ort specific (Notă: `10.0.0.1` poate fi scurtat la `10.1`):",
          "command": "ssh {{nume_utilizator}}@10.0.0.1 -p {{2222}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L17"
        },
        {
          "description": "Rulează o comandă pe un server la distanță cu alocare [t]ty pentru a permite interacțiunea cu comanda:",
          "command": "ssh {{nume_utilizator}}@{{server_distant}} -t {{comandă}} {{argumente_comandă}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L21"
        },
        {
          "description": "Tunelare SSH: redirecționare [D]inamică de port (proxy SOCKS pe `localhost:1080`):",
          "command": "ssh {{nume_utilizator}}@{{server_distant}} -D {{1080}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L25"
        },
        {
          "description": "Tunelare SSH: redirecționează un port specific (`localhost:9999` către `example.org:80`) dezactivând alocarea de pseudo-[T]ty și execuți[N]a comenzilor la distanță:",
          "command": "ssh {{nume_utilizator}}@{{server_distant}} -L {{9999}}:{{example.org}}:{{80}} -N -T",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L29"
        },
        {
          "description": "Salt SSH ([J]umping): conectare printr-un jumphost către un server la distanță (mai multe salturi pot fi specificate separate prin virgulă):",
          "command": "ssh {{nume_utilizator}}@{{server_distant}} -J {{nume_utilizator}}@{{jump_host}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L33"
        },
        {
          "description": "Închide o sesiune blocată:",
          "command": "<Enter><~><.>",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ro/common/ssh.md"
    },
