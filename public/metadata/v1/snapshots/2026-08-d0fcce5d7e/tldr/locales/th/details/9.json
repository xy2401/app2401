    {
      "id": "tldr--0b2876736ab9",
      "canonicalPath": "common/clamdscan.md",
      "locale": "th",
      "sourceLocale": "th",
      "name": "clamdscan",
      "title": "clamdscan",
      "summary": "โปรแกรมแสกนหาไวรัสบนคอมมานด์ไลน์ โดยใช้โปรแกรมพื้นหลัง ClamAV",
      "platform": "cross-platform",
      "softwareIds": [
        "clamav--35347620"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "แสกนข้อบกพร่องของไฟล์หรือไฟล์ในไดเรคทอรี:",
          "command": "clamdscan {{หนทาง/ไปยัง/ไฟล์_หรือ_ไดเรคทอรี่}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L8"
        },
        {
          "description": "แสกนข้อมูลจากสตรีมอินพุทมาตรฐาน:",
          "command": "{{คำสั่ง}} | clamdscan -",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L12"
        },
        {
          "description": "แสกนไดเรคทอรีปัจจุบันแล้วแสดงผลไฟล์ที่ตรวจพบความบกพร่อง:",
          "command": "clamdscan --infected",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L16"
        },
        {
          "description": "ส่งผลการแสกนไปยังไฟล์ที่ระบุ:",
          "command": "clamdscan --log {{หนทาง/ไปยัง/ไฟล์ที่ระบุ}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L20"
        },
        {
          "description": "ย้ายไฟล์ที่พบการติดไวรัสไปยังไดเรคทอรีที่ระบุ:",
          "command": "clamdscan --move {{หนทาง/ไปยัง/ไดเรคทอรีสำหรับการกักกัน}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L24"
        },
        {
          "description": "ลบไฟล์ที่พบการติดไวรัส:",
          "command": "clamdscan --remove",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L28"
        },
        {
          "description": "ใช้มัลติเธรดในการตรวจไดเรคทอรี:",
          "command": "clamdscan --multiscan",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L32"
        },
        {
          "description": "ส่งตัวอธิบายไฟล์ไปยังโปรแกรมแสกนพื้นหลังแทนการส่งไฟล์ข้อมูล:",
          "command": "clamdscan --fdpass",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/clamdscan.md"
    },
