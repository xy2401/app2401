      "name": "tldr",
      "title": "tldr",
      "summary": "แสดงตัวอย่างแบบง่ายสำหรับเครื่องมือบน command-line จากโปรเจคท์ tldr-pages",
      "platform": "cross-platform",
      "softwareIds": [
        "tealdeer--251e563d",
        "tldr--1f34cbae",
        "tldr--20c1a45b",
        "tlrc--36ec9796"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 4,
      "examples": [
        {
          "description": "แสดงตัวอย่างการใช้งานคำสั่งที่ใช้บ่อย (บอกใบ้นิดนึง: นี่คือเหตุผลที่คุณสนใจใช้บริการของเราใช่ไหมล่ะ!):",
          "command": "tldr {{command}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.th/common/tldr.md#L8"
        },
        {
          "description": "แสดงหน้า tldr ของคำสั่ง tar สำหรับระบบปฏิบัติการ Linux:",
