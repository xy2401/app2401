      "softwareIds": [
        "zoxide--61b3f139"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Aller au répertoire avec le meilleur classement qui contient \"foo\" dans son nom :",
          "command": "zoxide query {{foo}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fr/common/zoxide.md#L9"
        },
        {
          "description": "Aller au répertoire avec le meilleur classement qui contient \"foo\" et \"bar\" dans son nom :",
          "command": "zoxide query {{foo}} {{bar}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fr/common/zoxide.md#L13"
        },
        {
          "description": "Démarre une recherche de répertoire interactive (nécessite `fzf`) :",
