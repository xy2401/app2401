      "id": "tldr--8154cd749d1b",
      "canonicalPath": "windows/remove-item.md",
      "locale": "fr",
      "sourceLocale": "fr",
      "name": "Remove-Item",
      "title": "Remove-Item",
      "summary": "Supprime des fichier, des dossiers, ainsi que des clés et sous-clés de registre. Cette commande ne peut être exécutée que via PowerShell.",
      "platform": "windows",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Supprime des fichiers ou des clés de registre spécifiques (sans sous-clés) :",
          "command": "Remove-Item {{chemin\\vers\\fichier_ou_clé1 , chemin\\vers\\fichier_ou_clé2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fr/windows/remove-item.md#L9"
        },
        {
          "description": "Supprime des fichiers cachés ou en lecture seule :",
          "command": "Remove-Item -Force {{chemin\\vers\\fichier1 , chemin\\vers\\fichier2 ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fr/windows/remove-item.md#L13"
        },
        {
          "description": "Supprime des fichiers ou des clés de registre spécifiques en demandant une confirmation interactive avant chaque suppression :",
          "command": "Remove-Item -Confirm {{chemin\\vers\\fichier_ou_clé1 , chemin\\vers\\fichier_ou_clé2 ...}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fr/windows/remove-item.md#L17"
        },
        {
          "description": "Supprime des fichiers et répertoires spécifiques de manière récursive (Windows 10 version 1909 ou ultérieure) :",
          "command": "Remove-Item -Recurse {{chemin\\vers\\fichier_ou_répertoire1 , chemin\\vers\\fichier_ou_répertoire2 ...}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fr/windows/remove-item.md#L21"
        },
        {
          "description": "Supprime des clés de registre Windows spécifiques et toutes leurs sous-clés :",
          "command": "Remove-Item -Recurse {{chemin\\vers\\clé1 , chemin\\vers\\clé2 ...}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fr/windows/remove-item.md#L25"
        },
