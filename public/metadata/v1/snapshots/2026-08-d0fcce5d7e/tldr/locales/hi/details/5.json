      "summary": "कनेक्शन सेवा प्रोफाइल प्रबंधित करें।",
      "platform": "windows",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "एक विशेष प्रोफाइल स्थापित करें:",
          "command": "cmstp \"{{प्रोफ़ाइल_फ़ाइल\\का\\पथ}}\"",
          "line": 8,
