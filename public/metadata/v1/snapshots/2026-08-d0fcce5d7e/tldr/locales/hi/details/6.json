    {
      "id": "tldr--852253528963",
      "canonicalPath": "common/neofetch.md",
      "locale": "hi",
      "sourceLocale": "hi",
      "name": "neofetch",
      "title": "neofetch",
      "summary": "आपके ऑपरेटिंग सिस्टम, सॉफ्टवेयर और हार्डवेयर के बारे में जानकारी प्रदर्शित करने के लिए CLI टूल। यह भी देखें: `fastfetch`।",
      "platform": "cross-platform",
      "softwareIds": [
        "neofetch--d204d682"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 4,
      "examples": [
        {
          "description": "डिफ़ॉल्ट कॉन्फ़िगरेशन लौटाएं, और इसे बनाएं यदि यह पहली बार प्रोग्राम चलता है:",
          "command": "neofetch",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/neofetch.md#L9"
        },
        {
          "description": "आउटपुट में दिखाई देने से एक जानकारी लाइन को ट्रिगर करें, जहां 'infoname' कॉन्फ़िगरेशन फ़ाइल में फ़ंक्शन नाम है, उदा। स्मृति:",
          "command": "neofetch --{{enable|disable}} {{infoname}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/neofetch.md#L13"
        },
        {
          "description": "OS आर्किटेक्चर छुपाएं/दिखाएं:",
