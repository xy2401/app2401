      "exampleCount": 5,
      "examples": [
        {
          "description": "यादृच्छिक पासवर्डें बनाएं (पासवर्ड की डिफ़ॉल्ट लम्बाई 8 हैं):",
          "command": "apg",
          "line": 8,
