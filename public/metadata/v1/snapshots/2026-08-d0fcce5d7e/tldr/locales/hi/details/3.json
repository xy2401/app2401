      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "एक प्रमाणपत्र की सामग्री का निरीक्षण करें:",
          "command": "step certificate inspect {{सर्टिफिकेट.crt/का/पथ}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/step.md#L9"
        },
        {
          "description": "एक रूट CA प्रमाणपत्र और एक कुंजी बनाएँ (निजी कुंजी पासवर्ड सुरक्षा को छोड़ने के लिए `--no-password --insecure` जोड़ें):",
          "command": "step certificate create \"{{उदाहरण Root CA}}\" {{रूट-सीए.crt/का/पथ}} {{रूट-ca.key/का/पथ}} --profile root-ca",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/step.md#L13"
        },
        {
          "description": "एक विशिष्ट होस्टनाम के लिए एक प्रमाणपत्र उत्पन्न करें और इसे रूट CA के साथ हस्ताक्षरित करें (सरलीकरण के लिए CSR उत्पन्न करना छोड़ सकते हैं):",
          "command": "step certificate create {{hostname.example.com}} {{hostname.crt/का/पथ}} {{hostname.key/का/पथ}} --profile leaf --ca {{root-ca.crt/का/पथ}} --ca-key {{root-ca.key/का/पथ}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/step.md#L17"
        },
        {
          "description": "एक प्रमाणपत्र श्रृंखला की पुष्टि करें:",
          "command": "step certificate verify {{hostname.crt/का/पथ}} --roots {{root-ca.crt/का/पथ}} --verbose",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/step.md#L21"
        },
        {
          "description": "PEM फ़ॉर्मेट के प्रमाणपत्र को DER में परिवर्तित करें और इसे डिस्क पर लिखें:",
          "command": "step certificate format {{certificate.pem/का/पथ}} --out {{certificate.der/का/पथ}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/step.md#L25"
        },
        {
          "description": "सिस्टम के डिफ़ॉल्ट ट्रस्ट स्टोर में एक रूट प्रमाणपत्र स्थापित करें या हटा दें:",
          "command": "step certificate {{install|uninstall}} {{root-ca.crt/का/पथ}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/step.md#L29"
        },
        {
          "description": "एक RSA/EC निजी और सार्वजनिक कुंजी जोड़ी बनाएँ (निजी कुंजी पासवर्ड सुरक्षा को छोड़ने के लिए `--no-password --insecure` जोड़ें):",
          "command": "step crypto keypair {{सार्वजनिक/कुंजी/का/पथ}} {{निजी/कुंजी/का/पथ}} --kty {{RSA|EC}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/step.md#L33"
        },
        {
          "description": "उप-कमांड के लिए सहायता दिखाएँ:",
          "command": "step {{path|base64|certificate|completion|context|crl|crypto|oauth|ca|beta|ssh}} --help",
