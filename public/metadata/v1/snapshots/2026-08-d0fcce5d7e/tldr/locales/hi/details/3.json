      "platform": "freebsd",
      "softwareIds": [
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "सभी फाइल सिस्टम और उनके डिस्क उपयोग को 512-बाइट यूनिट्स में प्रदर्शित करें:",
          "command": "df",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/freebsd/df.md#L8"
