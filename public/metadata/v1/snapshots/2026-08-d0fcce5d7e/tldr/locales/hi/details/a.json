    {
      "id": "tldr--3fc2b746c811",
      "canonicalPath": "common/bfs.md",
      "locale": "hi",
      "sourceLocale": "hi",
      "name": "bfs",
      "title": "bfs",
      "summary": "अपनी फ़ाइलों के लिए चौड़ाई-प्रथम खोज।",
      "platform": "cross-platform",
      "softwareIds": [
        "bfs--a59a87c2"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "एक्सटेंशन द्वारा फ़ाइलें ढूंढें:",
          "command": "bfs {{रूट_पथ}} -name '{{*.ext}}'",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L8"
        },
        {
          "description": "एकाधिक पथ/नाम पैटर्न से मेल खाने वाली फ़ाइलें ढूंढें:",
          "command": "bfs {{रूट_पथ}} -path '{{**/पथ/**/*.ext}}' -or -name '{{*पैटर्न*}}'",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L12"
        },
        {
          "description": "केस-असंवेदनशील मोड में, किसी दिए गए नाम से मेल खाने वाली निर्देशिकाएँ खोजें:",
          "command": "bfs {{रूट_पथ}} -type d -iname '{{*lib*}}'",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L16"
        },
        {
          "description": "विशिष्ट पथों को छोड़कर, किसी दिए गए पैटर्न से मेल खाने वाली फ़ाइलें ढूंढें:",
          "command": "bfs {{रूट_पथ}} -name '{{*.py}}' -not -path '{{*/साइट-पैकेज/*}}'",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L20"
        },
        {
          "description": "किसी दिए गए आकार सीमा से मेल खाने वाली फ़ाइलें ढूंढें, पुनरावर्ती गहराई को \"1\" तक सीमित करें:",
          "command": "bfs {{रूट_पथ}} -maxdepth 1 -size {{+500k}} -size {{-10M}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L24"
        },
        {
          "description": "प्रत्येक फ़ाइल के लिए एक कमांड चलाएँ (फ़ाइल नाम तक पहुँचने के लिए कमांड के भीतर `{}` का उपयोग करें):",
          "command": "bfs {{रूट_पथ}} -name '{{*.ext}}' -exec {{wc -l}} {} \\;",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L28"
        },
        {
          "description": "आज संशोधित सभी फ़ाइलें ढूंढें और परिणामों को तर्क के रूप में एकल कमांड में पास करें:",
          "command": "bfs {{रूट_पथ}} -daystart -mtime {{-1}} -exec {{tar -cvf archive.tar}} {} \\+",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L32"
        },
        {
          "description": "खाली फ़ाइलें (0 बाइट) या निर्देशिकाएं ढूंढें और उन्हें शब्दशः हटाएं:",
          "command": "bfs {{रूट_पथ}} -type {{f|d}} -empty -delete -print",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.hi/common/bfs.md"
    },
