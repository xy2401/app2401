    {
      "id": "tldr--42489738ab06",
      "canonicalPath": "common/grep.md",
      "locale": "zh-TW",
      "sourceLocale": "zh_TW",
      "name": "grep",
      "title": "grep",
      "summary": "使用 `regex` 式搜尋檔案中的模式。 另請參閱：`rg`, `regex`。",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "grep--aeeff087",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "在檔案中搜尋模式：",
          "command": "grep \"{{模式字串}}\" {{路徑/至/檔案1 路徑/至/檔案2}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L9"
        },
        {
          "description": "搜尋精確的字串（停用 `regex` 式）：",
          "command": "grep {{[-F|--fixed-strings]}} \"{{字串}}\" {{路徑/至/檔案}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L13"
        },
        {
          "description": "在目錄中遞迴搜尋所有檔案中的模式，忽略二進位檔案：",
          "command": "grep {{[-rI|--recursive --binary-files=without-match]}} \"{{模式字串}}\" {{路徑/至/目錄}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L17"
        },
        {
          "description": "列印每個匹配項周圍、之前或之後的 3 行上下文：",
          "command": "grep {{--context|--before-context|--after-context}} 3 \"{{模式字串}}\" {{路徑/至/檔案}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L21"
        },
        {
          "description": "列印每個匹配項的檔案名稱和行號，並帶彩色輸出：",
          "command": "grep {{[-Hn|--with-filename --line-number]}} --color=always \"{{模式字串}}\" {{路徑/至/檔案}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L25"
        },
        {
          "description": "僅列印匹配的文本：",
          "command": "grep {{[-o|--only-matching]}} \"{{模式字串}}\" {{路徑/至/檔案}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L29"
        },
        {
          "description": "從 `stdin` （標準輸入）中讀取資料，不列印匹配模式的行：",
          "command": "cat {{路徑/至/檔案}} | grep {{[-v|--invert-match]}} \"{{模式字串}}\"",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L33"
        },
        {
          "description": "使用擴展 `regex` 式（支援 `?`、`+`、`{}`、`()` 和 `|`），不區分大小寫模式：",
          "command": "grep {{[-Ei|--extended-regexp --ignore-case]}} \"{{模式字串}}\" {{路徑/至/檔案}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/grep.md"
    },
