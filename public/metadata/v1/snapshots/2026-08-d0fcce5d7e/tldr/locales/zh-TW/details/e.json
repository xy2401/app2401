      "title": "cp",
      "summary": "複製檔案或整個目錄。",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "將檔案複製到另一個位置：",
          "command": "cp {{檔案一/完整/路徑}} {{檔案二/完整/路徑}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L8"
        },
        {
          "description": "將檔案複製到另一個目錄下，並保留原本的檔名：",
          "command": "cp {{檔案/完整/路徑}} {{目錄/完整/路徑}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L12"
        },
        {
          "description": "以遞迴方式將目錄一的內容複製到目錄二（如果目錄二存在，則目錄一複製為目錄二的子目錄）：",
          "command": "cp {{[-r|--recursive]}} {{目錄一/完整/路徑}} {{目錄二/完整/路徑}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L16"
        },
        {
          "description": "以詳細模式遞迴複製目錄（顯示複製的檔案）：",
          "command": "cp {{[-vr|--verbose --recursive]}} {{目錄一/完整/路徑}} {{目錄二/完整/路徑}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L20"
        },
        {
          "description": "一次複製多個檔案至目錄下：",
          "command": "cp {{[-t|--target-directory]}} {{目錄/完整/路徑}} {{檔案一/完整/路徑 檔案二/完整/路徑 ...}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L24"
        },
        {
          "description": "以互動模式將 txt 檔複製到另一個目錄下（在覆寫之前提示使用者）：",
          "command": "cp {{[-i|--interactive]}} {{*.txt}} {{目錄/完整/路徑}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L28"
        },
        {
          "description": "複製前遵循符號連結：",
          "command": "cp {{[-L|--dereference]}} {{符號連結}} {{目錄/完整/路徑}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L32"
        },
        {
          "description": "使用來源檔案的完整路徑，在複製時同時建立缺少的目錄：",
          "command": "cp --parents {{來源檔案/完整/路徑}} {{目標檔案/完整/路徑}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/cp.md"
    },
