      "id": "tldr--47d3afae94be",
      "canonicalPath": "common/crontab.md",
      "locale": "zh-TW",
      "sourceLocale": "zh_TW",
      "name": "crontab",
      "title": "crontab",
      "summary": "排程作業按時間間隔執行。",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "編輯目前使用者的排程文件：",
          "command": "crontab -e",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L8"
        },
        {
          "description": "編輯特定使用者的排程文件：",
          "command": "sudo crontab -e -u {{使用者名稱}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L12"
        },
        {
          "description": "用給定檔案的內容取代目前的排程文件：",
          "command": "crontab {{檔案/完整/路徑}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L16"
        },
        {
          "description": "查看目前使用者的排程：",
          "command": "crontab -l",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L20"
        },
        {
          "description": "刪除目前使用者的所有排程：",
          "command": "crontab -r",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L24"
        },
        {
          "description": "範例排程：每天於 10：00 時執行， `*` 表示任意值：",
          "command": "0 10 * * * {{執行命令}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L28"
        },
        {
          "description": "範例排程：每 10 分鐘執行一次命令：",
          "command": "*/10 * * * * {{執行命令}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L32"
        },
        {
          "description": "範例排程：每週五 02：30 執行sh檔：",
          "command": "30 2 * * Fri {{sh檔路徑}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/crontab.md"
    },
