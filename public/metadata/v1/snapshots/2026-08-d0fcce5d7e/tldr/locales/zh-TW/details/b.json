      "canonicalPath": "linux/ip-route-list.md",
      "locale": "zh-TW",
      "sourceLocale": "zh_TW",
      "name": "ip",
      "title": "ip route list",
      "summary": "用於顯示 IP 路由表管理的子指令。",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "顯示 `main` 路由表：",
          "command": "ip {{[r|route]}} {{[l|list]}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L8"
        },
        {
          "description": "顯示主要路由表（與第一個範例相同）：",
          "command": "ip {{[r|route]}} {{[l|list]}} {{[t|table]}} {{main|254}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L12"
        },
        {
          "description": "顯示本機路由表：",
          "command": "ip {{[r|route]}} {{[l|list]}} {{[t|table]}} {{local|255}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L16"
        },
        {
          "description": "顯示所有路由表：",
          "command": "ip {{[r|route]}} {{[l|list]}} {{[t|table]}} {{all|unspec|0}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L20"
        },
        {
          "description": "僅列出指定裝置的路由：",
          "command": "ip {{[r|route]}} {{[l|list]}} dev {{ethX}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L24"
        },
        {
          "description": "列出指定範圍內的路由：",
          "command": "ip {{[r|route]}} {{[l|list]}} {{[s|scope]}} link",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L28"
        },
        {
          "description": "顯示路由快取：",
          "command": "ip {{[r|route]}} {{[l|list]}} {{[c|cache]}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L32"
        },
        {
          "description": "僅顯示 IPv6 或 IPv4 路由：",
          "command": "ip {{-6|-4}} {{[r|route]}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/linux/ip-route-list.md#L36"
