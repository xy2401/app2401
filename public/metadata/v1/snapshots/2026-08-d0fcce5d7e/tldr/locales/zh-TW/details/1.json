        },
        {
          "description": "移除快捷鍵：",
          "command": "unalias {{快捷名稱}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/alias.md#L22"
