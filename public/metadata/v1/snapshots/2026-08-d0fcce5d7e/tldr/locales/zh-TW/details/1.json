      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "列出所有快捷鍵：",
          "command": "alias",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/alias.md#L10"
        },
        {
          "description": "建立快捷鍵：",
          "command": "alias {{快捷名稱}}=\"{{命令字串}}\"",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/alias.md#L14"
        },
        {
