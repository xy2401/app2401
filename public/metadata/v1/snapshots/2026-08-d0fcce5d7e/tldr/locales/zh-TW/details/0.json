    {
      "id": "tldr--03da635f46e2",
      "canonicalPath": "common/echo.md",
      "locale": "zh-TW",
      "sourceLocale": "zh_TW",
      "name": "echo",
      "title": "echo",
      "summary": "印出文字。 另請參閱：`printf`。",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "印出一行文字（如果文字中沒有連續的空格，可以不加引號）：",
          "command": "echo \"{{文字}}\"",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/echo.md#L9"
        },
        {
          "description": "印出包含環境變數的文字：",
          "command": "echo \"{{我的家目錄位於 $HOME}}\"",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/echo.md#L13"
        },
        {
          "description": "印出文字，但結尾不換行：",
          "command": "echo -n \"{{文字}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/echo.md#L17"
        },
        {
          "description": "將一段文字加到檔案的結尾：",
          "command": "echo \"{{文字}}\" >> {{檔案}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/echo.md#L21"
        },
        {
          "description": "將以開頭的跳脫序列轉換為特殊字元（例如「\\t」會被顯示為水平定位字元）：",
          "command": "echo -e \"{{第一欄\\t第二欄}}\"",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/echo.md#L25"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/echo.md"
    },
