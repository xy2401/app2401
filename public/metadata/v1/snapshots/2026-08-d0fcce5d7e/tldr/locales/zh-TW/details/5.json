      "exampleCount": 8,
      "examples": [
        {
          "description": "在目前目錄中遞迴搜尋匹配模式的內容（`regex`）：",
          "command": "rg {{模式}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/rg.md#L9"
        },
        {
          "description": "在指定檔案或目錄中遞迴搜尋匹配模式的內容：",
          "command": "rg {{模式}} {{路徑/至/檔案或目錄}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/rg.md#L13"
        },
        {
          "description": "搜尋字面字串模式：",
          "command": "rg {{[-F|--fixed-strings]}} -- {{字串}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/rg.md#L17"
        },
        {
          "description": "包含隱藏檔案以及 `.gitignore` 中列出的條目：",
          "command": "rg {{[-.|--hidden]}} --no-ignore {{模式}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/rg.md#L21"
        },
        {
          "description": "僅搜尋檔名匹配萬用字元（glob）模式的檔案（例如 `README.*`）：",
          "command": "rg {{模式}} {{[-g|--glob]}} {{檔名萬用字元模式}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/rg.md#L25"
        },
        {
          "description": "遞迴列出目前目錄中匹配模式的檔名：",
