    {
      "id": "tldr--0fd58bf273ba",
      "canonicalPath": "windows/fc.md",
      "locale": "zh-TW",
      "sourceLocale": "zh_TW",
      "name": "fc",
      "title": "fc",
      "summary": "比較兩個檔案或一組檔案間的差異。 以萬用字元 (*) 比較一組檔案。",
      "platform": "windows",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "比較兩個指定檔案：",
          "command": "fc {{檔案/完整/路徑1}} {{檔案/完整/路徑2}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md#L9"
        },
        {
          "description": "比較檔案且忽略大小寫差異：",
          "command": "fc /c {{檔案/完整/路徑1}} {{檔案/完整/路徑2}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md#L13"
        },
        {
          "description": "以 Unicode 文字檔方式比較檔案：",
          "command": "fc /u {{檔案/完整/路徑1}} {{檔案/完整/路徑2}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md#L17"
        },
        {
          "description": "以 ASCII 文字形式比較檔案：",
          "command": "fc /l {{檔案/完整/路徑1}} {{檔案/完整/路徑2}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md#L21"
        },
        {
          "description": "以二進位方式比較檔案：",
          "command": "fc /b {{檔案/完整/路徑1}} {{檔案/完整/路徑2}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md#L25"
        },
        {
          "description": "禁止將定位字元 (tab) 展開成空格：",
          "command": "fc /t {{檔案/完整/路徑1}} {{檔案/完整/路徑2}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md#L29"
        },
        {
          "description": "壓縮空白字元（定位字元與空格）後，再進行比較：",
          "command": "fc /w {{檔案/完整/路徑1}} {{檔案/完整/路徑2}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md#L33"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/windows/fc.md"
    },
