          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/fd.md#L9"
        },
        {
          "description": "在特定目錄中尋找檔案：",
          "command": "fd \"{{正規表示式}}\" {{路徑/至/檔案}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/fd.md#L13"
        },
        {
          "description": "尋找具有特定副檔名的檔案：",
          "command": "fd {{[-e|--extension]}} {{副檔名}}",
          "line": 17,
