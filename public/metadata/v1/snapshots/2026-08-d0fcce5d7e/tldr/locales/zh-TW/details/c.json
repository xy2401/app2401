  "items": [
    {
      "id": "tldr--128497a4fbb9",
      "canonicalPath": "common/bat.md",
      "locale": "zh-TW",
      "sourceLocale": "zh_TW",
      "name": "bat",
      "title": "bat",
      "summary": "可以列印並且合併檔案的命令。 `cat` 的複製品，外加語法高亮和 Git 整合。 另請參閱：`cat`。",
      "platform": "cross-platform",
      "softwareIds": [
        "bat--5892de4d"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "使用美化樣式列印一個或多個檔案的內容到 `stdout`：",
          "command": "bat {{路徑/至/檔案1 路徑/至/檔案2 ...}}",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L10"
        },
        {
          "description": "將多個檔案連接成一個目標檔案：",
          "command": "bat {{路徑/至/檔案1 路徑/至/檔案2 ...}} > {{路徑/至/目標檔案}}",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L14"
        },
        {
          "description": "移除修飾並停用分頁：",
          "command": "bat {{[-pp|--style plain --pager never]}} {{路徑/至/檔案}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L18"
        },
        {
          "description": "使用不同的背景顏色突顯顯示特定行或一行範圍：",
          "command": "bat {{[-H|--highlight-line]}} {{10|5:10|:10|10:|10:+5}} {{路徑/至/檔案}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L22"
        },
        {
          "description": "顯示不可列印字元，如空格、定位字元或換行：",
          "command": "bat {{[-A|--show-all]}} {{路徑/至/檔案}}",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L26"
        },
        {
          "description": "在輸出中只保留行號，移除所有其他修飾：",
          "command": "bat {{[-n|--number]}} {{路徑/至/檔案}}",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L30"
        },
        {
          "description": "透過明確設定語言來語法高亮顯示 JSON 檔案：",
          "command": "bat {{[-l|--language]}} json {{路徑/至/檔案.json}}",
          "line": 34,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L34"
        },
        {
          "description": "顯示所有支援的語言：",
          "command": "bat {{[-L|--list-languages]}}",
          "line": 38,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md#L38"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.zh_TW/common/bat.md"
    },
