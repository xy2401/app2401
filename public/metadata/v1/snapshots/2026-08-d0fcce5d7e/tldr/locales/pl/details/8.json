    {
      "id": "tldr--01b05401cd9d",
      "canonicalPath": "common/rsync.md",
      "locale": "pl",
      "sourceLocale": "pl",
      "name": "rsync",
      "title": "rsync",
      "summary": "Przesyłaj pliki do lub ze zdalnego hosta (ale nie pomiędzy dwoma zdalnymi hostami), domyślnie używając SSH. Aby wskazać na ścieżkę zdalną, użyj `user@host:ścieżka/do/pliku_lub_katalogu`.",
      "platform": "cross-platform",
      "softwareIds": [
        "rsync--6bcbc5c9"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Prześlij plik:",
          "command": "rsync {{ścieżka/do/źródła}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L9"
        },
        {
          "description": "Użyj trybu archiwum (rekursywnie kopiuj katalogi, kopiuj dowiązania symboliczne bez rozwiązywania i zachowaj uprawnienia, własność i czasy modyfikacji):",
          "command": "rsync {{[-a|--archive]}} {{ścieżka/do/źródła}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L13"
        },
        {
          "description": "Kompresuj dane podczas gdy są wysyłane do miejsca docelowego, wyświetlaj szczegółowy i czytelny dla człowieka postęp i zachowaj częściowo przesłane pliki w przypadku przerwania:",
          "command": "rsync {{[-zvhP|--compress --verbose --human-readable --partial --progress]}} {{ścieżka/do/źródła}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L17"
        },
        {
          "description": "Rekursywnie kopiuj katalogi:",
          "command": "rsync {{[-r|--recursive]}} {{ścieżka/do/źródła}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L21"
        },
        {
          "description": "Prześlij zawartość katalogu, ale nie sam katalog:",
          "command": "rsync {{[-r|--recursive]}} {{ścieżka/do/źródła/}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L25"
        },
        {
          "description": "Rekursywnie kopiuj katalogi, użyj trybu archiwum, rozwiąż dowiązania symboliczne i pomiń pliki, które są nowsze w miejscu docelowym:",
          "command": "rsync {{[-auL|--archive --update --copy-links]}} {{ścieżka/do/źródła}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L29"
        },
        {
          "description": "Prześlij katalog ze zdalnego hosta, na którym działa `rsyncd` i usuń pliki w miejscu docelowym, które nie istnieją w źródle:",
          "command": "rsync {{[-r|--recursive]}} --delete rsync://{{host}}:{{ścieżka/do/źródła}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L33"
        },
        {
          "description": "Prześlij plik poprzez SSH używając innego portu niż domyślny (22) i wyświetlaj globalny postęp:",
          "command": "rsync {{[-e|--rsh]}} 'ssh -p {{port}}' --info=progress2 {{host}}:{{ścieżka/do/źródła}} {{ścieżka/do/miejsca_docelowego}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/common/rsync.md"
    },
