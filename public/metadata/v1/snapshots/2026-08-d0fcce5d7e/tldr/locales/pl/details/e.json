          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/linux/apt-key.md#L9"
        },
        {
          "description": "Dodaj klucz do magazynu zaufanych kluczy:",
          "command": "apt-key add {{plik_z_kluczem_publicznym.asc}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/linux/apt-key.md#L13"
        },
        {
          "description": "Usuń klucz z magazynu zaufanych kluczy:",
          "command": "apt-key del {{id_klucza}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/linux/apt-key.md#L17"
        },
        {
          "description": "Dodaj zdalny klucz do magazynu zaufanych kluczy:",
          "command": "wget {{[-qO|--quiet --output-document]}} - {{https://host.tld/nazwa_pliku.key}} | apt-key add -",
