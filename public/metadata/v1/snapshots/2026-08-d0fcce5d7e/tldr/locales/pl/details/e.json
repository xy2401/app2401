      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "Wygeneruj listę serwerów lustrzanych używając domyślnych ustawień:",
          "command": "sudo pacman-mirrors --fasttrack",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/linux/pacman-mirrors.md#L10"
