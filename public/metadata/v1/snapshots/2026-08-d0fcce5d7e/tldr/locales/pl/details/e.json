        {
          "description": "Wyświetl status aktualnych serwerów lustrzanych:",
          "command": "pacman-mirrors --status",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/linux/pacman-mirrors.md#L14"
        },
        {
          "description": "Pokaż aktualną gałąź:",
          "command": "pacman-mirrors --get-branch",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pl/linux/pacman-mirrors.md#L18"
        },
