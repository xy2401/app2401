    {
      "id": "tldr--35ed0d20785a",
      "canonicalPath": "common/aria2c.md",
      "locale": "fa",
      "sourceLocale": "fa",
      "name": "aria2c",
      "title": "aria2c",
      "summary": "ابزاری برای دانلود سریع. قابلیت پشتیبانی از Http(s), FTP, SFTP, BitTorrent, Metalink. همچنین : `axel`.",
      "platform": "cross-platform",
      "softwareIds": [
        "aria2--38b2c545",
        "aria2-134--56e83316"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "دانلود لینک موردنظر و ذخیره در فایل:",
          "command": "aria2c \"{{url}}\"",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L10"
        },
        {
          "description": "دانلود یک فایل از لینک موردنظر با اسم خروجی دلخواه:",
          "command": "aria2c {{[-o|--out]}} {{path/to/file}} \"{{url}}\"",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L14"
        },
        {
          "description": "دانلود چند فایل مختلف به صورت همزمان:",
          "command": "aria2c {{[-Z|--force-sequential=true]}} {{\"url1\" \"url2\" ...}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L18"
        },
        {
          "description": "دانلود از چند لینک مختلف:",
          "command": "aria2c {{\"url1\" \"url2\" ...}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L22"
        },
        {
          "description": "دانلود لینک های لیست شده در یک فایل همراه با تنظیم تعداد دانلود های همزمان:",
          "command": "aria2c --input-file={{path/to/file}} --max-concurrent-downloads={{number_of_downloads}}",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L26"
        },
        {
          "description": "دانلود با چندین اتصال مختلف:",
          "command": "aria2c {{[-s|--split]}} {{number_of_connections}} \"{{url}}\"",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L30"
        },
        {
          "description": "دانلود از FTP با نام کاربری و رمزعبور:",
          "command": "aria2c --ftp-user={{username}} --ftp-passwd={{password}} \"{{url}}\"",
          "line": 34,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L34"
        },
        {
          "description": "محدود کردن سرعت دانلود با واحد بایت بر ثانیه:",
          "command": "aria2c --max-download-limit={{speed}} \"{{url}}\"",
          "line": 38,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md#L38"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/aria2c.md"
    },
