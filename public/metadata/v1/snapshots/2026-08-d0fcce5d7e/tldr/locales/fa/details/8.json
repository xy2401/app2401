    {
      "id": "tldr--002a6f1cb1d5",
      "canonicalPath": "linux/yum.md",
      "locale": "fa",
      "sourceLocale": "fa",
      "name": "yum",
      "title": "yum",
      "summary": "ابزار مدیریت بسته برای ردهت، فدورا و سنت اواس(برای نسخه های قدیمی).",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "نصب یک بسته:",
          "command": "yum install {{package}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/linux/yum.md#L8"
        },
        {
          "description": "نصب یک بسته با فرض بر اینکه پاسخ شما برای تمامی سوالات بله است(با گزینه update هم می توان از این روش استفاده کرد، مناسب برای به روز رسانی خودکار):",
          "command": "yum -y install {{package}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/linux/yum.md#L12"
        },
        {
          "description": "پیدا کردن بسته ای که دستور مورد نظر را فراهم می کند:",
          "command": "yum provides {{command}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/linux/yum.md#L16"
        },
        {
          "description": "حذف یک بسته:",
          "command": "yum remove {{package}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/linux/yum.md#L20"
        },
        {
          "description": "نمایش به روز رسانی ها برای بسته های نصب شده:",
          "command": "yum check-update",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/linux/yum.md#L24"
        },
        {
          "description": "به روز رسانی بسته های نصب شده به آخرین نسخه موجود:",
          "command": "yum upgrade",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/linux/yum.md#L28"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/linux/yum.md"
