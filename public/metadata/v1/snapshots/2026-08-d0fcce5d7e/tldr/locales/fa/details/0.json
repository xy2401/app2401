      "summary": "چاپ ورودی داده شده. همچنین : `printf`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
