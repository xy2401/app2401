          "command": "echo \"{{سلام دنیا}}\"",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/echo.md#L9"
        },
        {
          "description": "چاپ یک پیام حاوی متغییرهای سیستمی:",
          "command": "echo \"{{مسیر سیستم من $PATH است.}}\"",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/echo.md#L13"
        },
        {
          "description": "چاپ یک پیام بدون انتقال به خط جدید:",
          "command": "echo -n \"{{سلام دنیا}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/echo.md#L17"
