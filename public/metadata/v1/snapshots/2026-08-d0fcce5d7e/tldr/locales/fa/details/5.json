    {
      "id": "tldr--21ba38eeddf8",
      "canonicalPath": "common/2to3.md",
      "locale": "fa",
      "sourceLocale": "fa",
      "name": "2to3",
      "title": "2to3",
      "summary": "تبدیل خودکار کد پایتون نسخه 2 به 3.",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "نمایش تغییرات که در حال حاضر انجام میشود بدون اجرای آن (dry-run) :",
          "command": "2to3 {{path/to/file.py}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md#L8"
        },
        {
          "description": "تبدیل فایل پایتون نسخه 2 به 3 :",
          "command": "2to3 {{[-w|--write]}} {{path/to/file.py}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md#L12"
        },
        {
          "description": "تبدیل قابلیت های خاص پایتون نسخه 2 به 3 :",
          "command": "2to3 {{[-w|--write]}} {{path/to/file.py}} {{[-f|--fix]}} {{raw_input}} {{[-f|--fix]}} {{print}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md#L16"
        },
        {
          "description": "تبدیل تمامی قابلیت های نسخه 2 به 3 بغیر از ویژگی های معیین شده :",
          "command": "2to3 {{[-w|--write]}} {{path/to/file.py}} {{[-x|--nofix]}} {{has_key}} {{[-x|--nofix]}} {{isinstance}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md#L20"
        },
        {
          "description": "نمایش لیست قابلیت های زبان پایتون نسخه 2 که قابلیت تبدیل به نسخه 3 را دارند :",
          "command": "2to3 {{[-l|--list-fixes]}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md#L24"
        },
        {
          "description": "تبدیل تمامی فایل های پایتون نسخه 2 به 3 در یک مسیر :",
          "command": "2to3 {{[-o|--output-dir]}} {{path/to/python3_directory}} {{[-W|--write-unchanged-files]}} {{[-n|--nobackups]}} {{path/to/python2_directory}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md#L28"
        },
        {
          "description": "اجرای همزان(چند رشته ای) دستور 2 به 3 :",
          "command": "2to3 {{[-j|--processes]}} {{4}} {{[-o|--output-dir]}} {{path/to/python3_directory}} {{[-w|--write]}} {{[-n|--nobackups]}} --no-diffs {{path/to/python2_directory}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md#L32"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/2to3.md"
    },
