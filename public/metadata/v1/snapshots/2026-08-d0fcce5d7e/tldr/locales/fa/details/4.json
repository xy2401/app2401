    {
      "id": "tldr--0a5f270a5f03",
      "canonicalPath": "common/alex.md",
      "locale": "fa",
      "sourceLocale": "fa",
      "name": "alex",
      "title": "alex",
      "summary": "نوشته های نادرست و مشکل دار پیدا کنید. به شما کمک می کند نوشته های حاوی تعصب جنسیتی، دوقطبی کننده جامعه، نژاد پرستانه، توهین به مذاهب و سایر جملات مشابه را پیدا کنید.",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 4,
      "examples": [
        {
          "description": "بررسی کردن متن ورودی از `stdin`:",
          "command": "echo {{His network looks good}} | alex --stdin",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/alex.md#L9"
        },
        {
          "description": "بررسی تمام فایل های موجود در این دایرکتوری:",
          "command": "alex",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/alex.md#L13"
        },
        {
          "description": "بررسی یک فایل خاص:",
          "command": "alex {{path/to/file.md}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/alex.md#L17"
        },
        {
          "description": "بررسی تمام فایل های نشانه گذاری به جز `example.md`:",
          "command": "alex *.md !example.md",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/alex.md#L21"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/alex.md"
    },
