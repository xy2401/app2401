      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "افزودن فایل‌ها/پوشه‌ها به یک آرشیو مشخص (به صورت بازگشتی):",
          "command": "zip {{[-r|--recurse-paths]}} {{path/to/compressed.zip}} {{path/to/file_or_directory1 path/to/file_or_directory2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/zip.md#L9"
        },
        {
          "description": "حذف فایل‌ها/پوشه‌ها از یک آرشیو مشخص:",
          "command": "zip {{[-d|--delete]}} {{path/to/compressed.zip}} {{path/to/file_or_directory1 path/to/file_or_directory2 ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/zip.md#L13"
        },
        {
          "description": "آرشیو فایل‌ها/پوشه‌ها با مستثنی کردن موارد مشخص شده:",
          "command": "zip {{[-r|--recurse-paths]}} {{path/to/compressed.zip}} {{path/to/file_or_directory1 path/to/file_or_directory2 ...}} {{[-x|--exclude]}} {{path/to/excluded_files_or_directories}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/zip.md#L17"
        },
        {
          "description": "آرشیو فایل‌ها/پوشه‌ها با سطح فشرده‌سازی مشخص (`0` - کمترین، `9` - بیشترین):",
          "command": "zip {{[-r|--recurse-paths]}} -{{0..9}} {{path/to/compressed.zip}} {{path/to/file_or_directory1 path/to/file_or_directory2 ...}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/zip.md#L21"
        },
        {
          "description": "ایجاد یک آرشیو رمزگذاری شده با رمز عبور مشخص:",
          "command": "zip {{[-re|--recurse-paths --encrypt]}} {{path/to/compressed.zip}} {{path/to/file_or_directory1 path/to/file_or_directory2 ...}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/zip.md#L25"
        },
        {
          "description": "آرشیو فایل‌ها/پوشه‌ها در یک آرشیو چند بخشی تقسیم شده (مثلاً بخش‌های ۳ گیگابایتی):",
          "command": "zip {{[-rs|--recurse-paths --split-size]}} {{3g}} {{path/to/compressed.zip}} {{path/to/file_or_directory1 path/to/file_or_directory2 ...}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/zip.md#L29"
