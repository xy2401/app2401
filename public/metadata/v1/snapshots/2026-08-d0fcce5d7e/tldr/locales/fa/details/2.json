          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/cppclean.md#L16"
        },
        {
          "description": "اجرا روی پوشه کنونی به استثنای پوشه \"build\":",
          "command": "cppclean {{.}} --exclude {{build}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/cppclean.md#L20"
