      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 4,
      "examples": [
        {
          "description": "اجرا در پوشه ی پروژه:",
          "command": "cppclean {{path/to/project}}",
          "line": 8,
