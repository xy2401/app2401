          "command": "cppclean {{path/to/project}} --include-path {{inc1}} --include-path {{inc2}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.fa/common/cppclean.md#L12"
        },
