      "canonicalPath": "common/cp.md",
      "locale": "ca",
      "sourceLocale": "ca",
      "name": "cp",
      "title": "cp",
      "summary": "Copia fitxers i directoris.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Copia un fitxer a un altre directori:",
          "command": "cp {{camí/al/fitxer_origen.ext}} {{camí/al/fitxer_destí.ext}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/common/cp.md#L8"
        },
        {
          "description": "Copia un fitxer a un altre directori, mantenint el nom:",
          "command": "cp {{camí/al/fitxer_origen.ext}} {{camí/al/directori}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/common/cp.md#L12"
        },
        {
          "description": "Copia recursivament els continguts d'un directori a un altre (si aquest existeix,els continguts es copien dins):",
          "command": "cp -R {{camí/al/directori_origen}} {{camí/al/directori_destí}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/common/cp.md#L16"
        },
        {
          "description": "Copia un directori recursivament, de manera verbosa (mostra els fitxers a mesura que es van copiant):",
          "command": "cp -vR {{camí/al/directori_origen}} {{camí/al/directori_destí}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/common/cp.md#L20"
        },
        {
          "description": "Copia els fitxers amb extensió `.txt` a una altra ubicació en mode interactiu (demana al usuari abans de sobreescriure un fitxer):",
          "command": "cp -i {{*.txt}} {{camí/al/directori_destí}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/common/cp.md#L24"
        },
        {
          "description": "Copia enllaços simbòlics sense mantenir la referència al original:",
          "command": "cp -L {{enllaç}} {{camí/al/directori_destí}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/common/cp.md#L28"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/common/cp.md"
