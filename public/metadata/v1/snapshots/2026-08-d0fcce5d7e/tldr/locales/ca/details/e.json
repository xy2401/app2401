      "id": "tldr--356d34407e14",
      "canonicalPath": "linux/apt-key.md",
      "locale": "ca",
      "sourceLocale": "ca",
      "name": "apt-key",
      "title": "apt-key",
      "summary": "Eina de gestió de claus per al Gestor de Paquets APT (APT Package Manager) en Debian i Ubuntu. Nota: `apt-key` és obsolet (excepte l'ús de `apt-key del` en scrits de mantenidor).",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "Mostra les claus de confiança:",
          "command": "apt-key list",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/apt-key.md#L9"
        },
        {
          "description": "Afegeix una clau al magatzem de claus de confiança:",
          "command": "apt-key add {{arxiu_clau_pública.asc}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/apt-key.md#L13"
        },
        {
          "description": "Borra una clau del magatzem de claus de confiança:",
          "command": "apt-key del {{id_clau}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/apt-key.md#L17"
        },
        {
          "description": "Afegir una clau remota al magatzem de claus de confiança:",
          "command": "wget {{[-qO|--quiet --output-document]}} - {{https://host.tld/archiu.clau}} | apt-key add -",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/apt-key.md#L21"
        },
        {
          "description": "Afegir una clau d'un servidor de claus amb l'identificador de la clau:",
          "command": "apt-key adv --keyserver {{pgp.mit.edu}} --recv {{id_clau}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/apt-key.md#L25"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/apt-key.md"
