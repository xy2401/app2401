      "id": "tldr--fd190fa6acd7",
      "canonicalPath": "linux/cpulimit.md",
      "locale": "ca",
      "sourceLocale": "ca",
      "name": "cpulimit",
      "title": "cpulimit",
      "summary": "Eina per limitar l'ús de la CPU en altres processos.",
      "platform": "linux",
      "softwareIds": [
        "cpulimit--06bd4e17"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Limita un procés existent amb PID 1234 perquè només utilitzi el 25% de CPU:",
          "command": "cpulimit {{[-p|--pid]}} {{1234}} {{[-l|--limit]}} {{25%}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/cpulimit.md#L8"
        },
        {
          "description": "Limita un programa existent per el seu nom d'execució:",
          "command": "cpulimit {{[-e|--exe]}} {{programa}} {{[-l|--limit]}} {{25}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/cpulimit.md#L12"
        },
        {
          "description": "Executa un programa determinat i limita el seu ús a només el 50% de la CPU:",
          "command": "cpulimit {{[-l|--limit]}} {{50}} -- {{programa argument1 argument2 ...}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/cpulimit.md#L16"
        },
        {
          "description": "Executa un programa, limita l'ús de la CPU a 50% i executa cpulimit en segon pla:",
          "command": "cpulimit {{[-l|--limit]}} {{50}} {{[-b|--background]}} -- {{programa}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/cpulimit.md#L20"
        },
        {
          "description": "Mata el procés si l'ús de CPU del programa supera el 50%:",
          "command": "cpulimit {{[-l|--limit]}} 50 {{[-k|--kill]}} -- {{programa}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/cpulimit.md#L24"
        },
        {
          "description": "Regula el seu procés i els subprocessos perquè cap superi el 25% de CPU:",
          "command": "cpulimit {{[-l|--limit]}} {{25}} {{[-m|--monitor-forks]}} -- {{programa}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/cpulimit.md#L28"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/cpulimit.md"
    },
