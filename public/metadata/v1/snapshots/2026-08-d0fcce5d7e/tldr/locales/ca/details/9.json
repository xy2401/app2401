      "id": "tldr--742735839d69",
      "canonicalPath": "linux/ufw.md",
      "locale": "ca",
      "sourceLocale": "ca",
      "name": "ufw",
      "title": "ufw",
      "summary": "Tallafocs sense complicacions (_Uncomplicated Firewall_). Interfície d'usuari de `iptables` per facilitar la configuració d'un firewall.",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Activa ufw:",
          "command": "sudo ufw enable",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L9"
        },
        {
          "description": "Desactiva ufw:",
          "command": "sudo ufw disable",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L13"
        },
        {
          "description": "Mostra les regles del ufw, en conjunt amb els seus números:",
          "command": "sudo ufw status numbered",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L17"
        },
        {
          "description": "Permet el tràfic entrant en el port 5432 en aquest host amb un comentari que indentifiqui el servei:",
          "command": "sudo ufw allow 5432 comment \"{{servei}}\"",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L21"
        },
        {
          "description": "Permet només el tràfic TCP desde 192.168.0.4 a qualsevol direcció d'aquest host, en el port 22:",
          "command": "sudo ufw allow proto tcp from 192.168.0.4 to any port 22",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L25"
        },
        {
          "description": "Denega el tràfic en el port 80 en aquest host:",
          "command": "sudo ufw deny 80",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L29"
        },
        {
          "description": "Denega tot el tràfic al port 22:",
          "command": "sudo ufw deny proto udp from any to any port 22",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L33"
        },
        {
          "description": "Elimina una regla concreta. El número de la regla es pot obtenir del comanadament `ufw status numbered`:",
          "command": "sudo ufw delete {{número_de_regla}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/ufw.md"
    },
