      "id": "tldr--195e3f3c0992",
      "canonicalPath": "linux/service.md",
      "locale": "ca",
      "sourceLocale": "ca",
      "name": "service",
      "title": "service",
      "summary": "Gestiona els serveis mitjançant l'execució de scripts init. S'ha d'ometre la ruta completa del script (s'assumeix `/etc/init.d`).",
      "platform": "linux",
      "softwareIds": [
        "nssm--b05e71d6",
        "srvman--bf6dc44e"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 4,
      "examples": [
        {
          "description": "Llista el nom i l'estat de tots els serveis:",
          "command": "service --status-all",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/service.md#L9"
        },
        {
          "description": "Inicia/Para/Reinicia/Recarrega servei (_start_/_stop_ hauria d'estar sempre disponible):",
          "command": "service {{nom_del_servei}} {{start|stop|restart|reload}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/service.md#L13"
        },
        {
          "description": "Fa un reinici complet (executa el script dues vegades amb _start_ i _stop_):",
          "command": "service {{nom_del_servei}} --full-restart",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/service.md#L17"
        },
        {
          "description": "Mostra l'estat actual d'un servei:",
          "command": "service {{nom_del_servei}} status",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/service.md#L21"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ca/linux/service.md"
