    {
      "id": "tldr--16ed77dea912",
      "canonicalPath": "common/chmod.md",
      "locale": "pt-PT",
      "sourceLocale": "pt_PT",
      "name": "chmod",
      "title": "chmod",
      "summary": "Alterar as permissões de acesso a um ficheiro ou diretório.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "Dá a um [u]tilizador que possui um ficheiro o direito a e[x]ecutá-lo:",
          "command": "chmod u+x {{caminho/para/ficheiro}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md#L8"
        },
        {
          "description": "Dá a um [u]tilizador direitos para le[r] e escreve ([w]) num ficheiro/diretório:",
          "command": "chmod u+rw {{caminho/para/ficheiro_ou_diretório}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md#L12"
        },
        {
          "description": "Remove direitos de execução de um [g]rupo:",
          "command": "chmod g-x {{caminho/para/ficheiro}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md#L16"
        },
        {
          "description": "Dá a todos ([a]) os utilizadores o direito de le[r] e e[x]ecutar:",
          "command": "chmod a+rx {{caminho/para/ficheiro}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md#L20"
        },
        {
          "description": "Dá a [o]utros (que não estão no grupo do dono do ficheiro) os mesmos direitos do [g]rupo:",
          "command": "chmod o=g {{caminho/para/ficheiro}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md#L24"
        },
        {
          "description": "Remove todos os direitos dos [o]utros:",
          "command": "chmod o= {{caminho/para/ficheiro}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md#L28"
        },
        {
          "description": "Muda as permissões, recursivamente, dando ao [g]rupo e [o]utros a possibilidade de escrever ([w]):",
          "command": "chmod {{[-R|--recursive]}} g+w,o+w {{caminho/para/diretório}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md#L32"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/chmod.md"
    },
