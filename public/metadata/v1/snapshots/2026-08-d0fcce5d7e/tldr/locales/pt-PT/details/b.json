      "name": "7zr",
      "title": "7zr",
      "summary": "Compactador de arquivos com uma alta taxa de compressão. Semelhante ao '7z', com a diferença que suporta apenas ficheiros '.7z'.",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Adiciona um ficheiro ou diretório a um novo ou existente arquivo:",
          "command": "7zr a {{caminho/para/arquivo_compactado.7z}} {{caminho/para/ficheiro_ou_diretório}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/7zr.md#L9"
        },
        {
          "description": "Encripa um arquivo existente (incluindo filenames):",
          "command": "7zr a {{caminho/para/ficheiro_encriptado.7z}} -p{{palavra-passe}} -mhe=on {{caminho/para/arquivo_compactado.7z}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/7zr.md#L13"
        },
        {
          "description": "Descompacta um arquivo mantendo a estrutura de diretórios original:",
          "command": "7zr x {{caminho/para/arquivo_compactado.7z}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/7zr.md#L17"
        },
        {
          "description": "Descompacta um arquivo para um diretório especificado pelo utilizador:",
          "command": "7zr x {{caminho/para/arquivo_compactado.7z}} -o{{caminho/para/diretório}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/7zr.md#L21"
        },
        {
          "description": "Descompacta um arquivo para a saída padrão (`stdout`):",
          "command": "7zr x {{caminho/para/arquivo_compactado.7z}} -so",
          "line": 25,
