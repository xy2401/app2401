      "canonicalPath": "common/alias.md",
      "locale": "pt-PT",
      "sourceLocale": "pt_PT",
      "name": "alias",
      "title": "alias",
      "summary": "Cria um alias -- palavras que são substituídas por um comando. Alias expiram com a sessão da shell atual, a menos que sejam definidos no ficheiro de configuração da shell, por exemplo `~/.bashrc`. Veja também: `unalias`.",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Lista todos os alias:",
          "command": "alias",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/alias.md#L10"
        },
        {
          "description": "Cria um alias genérico:",
          "command": "alias {{palavra}}=\"{{comando}}\"",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/alias.md#L14"
        },
        {
          "description": "Visualiza o comando associado a um dado alias:",
          "command": "alias {{palavra}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/alias.md#L18"
        },
        {
          "description": "Remove um alias de um comando:",
          "command": "unalias {{palavra}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/alias.md#L22"
        },
        {
          "description": "Torna `rm` num comando interativo:",
          "command": "alias rm=\"rm -i\"",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/alias.md#L26"
        },
        {
          "description": "Cria `la` como um atalho para `ls -a`:",
          "command": "alias la=\"ls -a\"",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/alias.md#L30"
        }
