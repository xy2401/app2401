    {
      "id": "tldr--44d1d26fa037",
      "canonicalPath": "osx/route.md",
      "locale": "pt-PT",
      "sourceLocale": "pt_PT",
      "name": "route",
      "title": "route",
      "summary": "Alteração manual da tabela de rotas. Necessita de root.",
      "platform": "macos",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Adiciona uma rota para um destino passando por um gateway:",
          "command": "sudo route add \"{{endereco_ip_destino}}\" \"{{endereco_gateway}}\"",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/osx/route.md#L9"
        },
        {
          "description": "Adiciona uma rota para um rede /24 passando por um gateway:",
          "command": "sudo route add \"{{endereco_ip_subnet}}/24\" \"{{endereco_gateway}}\"",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/osx/route.md#L13"
        },
        {
          "description": "Corre em modo de teste (não realiza alterações, apenas a mostra):",
          "command": "sudo route -t add \"{{endereco_ip_destino}}/24\" \"{{endereco_gateway}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/osx/route.md#L17"
        },
        {
          "description": "Remove todas as rotas:",
          "command": "sudo route flush",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/osx/route.md#L21"
        },
        {
          "description": "Remove uma rota especifica:",
          "command": "sudo route delete \"{{endereco_ip_destino}}/24\"",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/osx/route.md#L25"
        },
        {
          "description": "Procura e mostra a rota para um destino (nome da máquina ou endereço IP):",
          "command": "sudo route get \"{{destino}}\"",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/osx/route.md#L29"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/osx/route.md"
