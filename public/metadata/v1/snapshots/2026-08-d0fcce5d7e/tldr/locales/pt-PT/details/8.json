    {
      "id": "tldr--66219ef97f0c",
      "canonicalPath": "common/yt-dlp.md",
      "locale": "pt-PT",
      "sourceLocale": "pt_PT",
      "name": "yt-dlp",
      "title": "yt-dlp",
      "summary": "Um fork do youtube-dl com funcionalidades e correções adicionais. Descarrega vídeos do YouTube e de outros websites. Veja também: `ytfzf`.",
      "platform": "cross-platform",
      "softwareIds": [
        "yt-dlp--08eee2f0",
        "yt-dlp-master--b62b97df",
        "yt-dlp-nightly--44f25745"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "Descarrega um vídeo ou playlist (com as opções predefinidas):",
          "command": "yt-dlp \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md#L10"
        },
        {
          "description": "Descarrega um vídeo num formato específico, neste caso o melhor vídeo mp4 disponível (a predefinição é \"bv\\*+ba/b\"):",
          "command": "yt-dlp --format \"{{bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]}}\" \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md#L14"
        },
        {
          "description": "Extrai áudio de vídeos (requer o `ffmpeg` ou o `ffprobe`):",
          "command": "yt-dlp --extract-audio \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md#L18"
        },
        {
          "description": "Especifica a qualidade do áudio extraído, entre 0 (melhor) e 10 (pior), sendo 5 a predefinição:",
          "command": "yt-dlp --extract-audio --audio-format {{mp3}} --audio-quality {{0}} \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md#L22"
        },
        {
          "description": "Descarrega todas as playlists de um canal ou utilizador do YouTube, mantendo cada playlist num diretório separado:",
          "command": "yt-dlp -o \"{{%(uploader)s/%(playlist)s/%(indice_playlist)s - %(titulo)s.%(ext)s}}\" \"{{https://www.youtube.com/user/TheLinuxFoundation/playlists}}\"",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md#L26"
        },
        {
          "description": "Descarrega um curso do Udemy, mantendo cada capítulo num diretório em separado, dentro do diretório \"MyVideos\" na home do utilizador:",
          "command": "yt-dlp -u {{usuario}} -p {{palavra_passe}} -P \"{{~/MyVideos}}\" -o \"{{%(playlist)s/%(numero_capitulo)s - %(capitulo)s/%(titulo)s.%(ext)s}}\" \"{{https://www.udemy.com/java-tutorial}}\"",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md#L30"
        },
        {
          "description": "Descarrega temporadas completas de séries, mantendo cada série e cada temporada num diretório separado, em C:\\MyVideos:",
          "command": "yt-dlp -P \"{{C:/MyVideos}}\" -o \"{{%(serie)s/%(numero_temporada)s - %(temporada)s/%(numero_episodio)s - %(episodio)s.%(ext)s}}\" \"{{https://videomore.ru/kino_v_detalayah/5_sezon/367617}}\"",
          "line": 34,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md#L34"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.pt_PT/common/yt-dlp.md"
    },
