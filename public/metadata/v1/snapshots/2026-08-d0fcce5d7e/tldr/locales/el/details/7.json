      "id": "tldr--9b813d7fdec5",
      "canonicalPath": "common/cat.md",
      "locale": "el",
      "sourceLocale": "el",
      "name": "cat",
      "title": "cat",
      "summary": "Εκτύπωση και συνένωση αρχείων.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "Εκτύπωση των περιεχομένων ενός αρχείου στο `stdout`:",
          "command": "cat {{διαδρομή/προς/αρχείο}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/cat.md#L8"
        },
        {
          "description": "Συνένωση πολλών αρχείων σε ένα αρχείο εξόδου:",
          "command": "cat {{διαδρομή/προς/αρχείο1 διαδρομή/προς/αρχείο2 ...}} > {{διαδρομή/προς/αρχείο_εξόδου}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/cat.md#L12"
        },
        {
          "description": "Προσθήκη πολλών αρχείων στο τέλος ενός αρχείου εξόδου:",
          "command": "cat {{διαδρομή/προς/αρχείο1 διαδρομή/προς/αρχείο2 ...}} >> {{διαδρομή/προς/αρχείο_εξόδου}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/cat.md#L16"
        },
        {
          "description": "Αντιγραφή των περιεχομένων ενός αρχείου σε ένα αρχείο εξόδου χωρίς buffering:",
          "command": "cat -u {{/dev/tty12}} > {{/dev/tty13}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/cat.md#L20"
        },
        {
          "description": "Εγγραφή `stdin` σε ένα αρχείο:",
          "command": "cat - > {{διαδρομή/προς/αρχείο}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/cat.md#L24"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/cat.md"
