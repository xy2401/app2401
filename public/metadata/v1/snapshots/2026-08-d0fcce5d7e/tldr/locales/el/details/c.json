      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Λίστα αρχείων, ένα ανά γραμμή:",
          "command": "ls -1",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L8"
        },
        {
          "description": "Λίστα όλων των αρχείων, συμπεριλαμβανομένων των κρυφών αρχείων:",
          "command": "ls {{[-a|--all]}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L12"
        },
        {
          "description": "Λίστα αρχείων με προσθήκη συμβόλου στο τέλος για την ένδειξη τύπου αρχείου (κατάλογος/, συμβολικός_σύνδεσμος@, εκτελέσιμο*, ...):",
          "command": "ls {{[-F|--classify]}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L16"
        },
        {
          "description": "Λίστα όλων των αρχείων σε αναλυτική μορφή (δικαιώματα, ιδιοκτησία, μέγεθος και ημερομηνία τροποποίησης):",
          "command": "ls {{[-la|-l --all]}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L20"
        },
        {
          "description": "Λίστα αρχείων σε αναλυτική μορφή με εμφάνιση μεγέθους χρησιμοποιώντας μονάδες αναγνώσιμες από ανθρώπους (KiB, MiB, GiB):",
          "command": "ls {{[-lh|-l --human-readable]}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L24"
        },
        {
          "description": "Λίστα αρχείων σε αναλυτική μορφή, ταξινομημένη κατά μέγεθος (φθίνουσα σειρά) αναδρομικά:",
          "command": "ls {{[-lSR|-lS --recursive]}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L28"
        },
        {
          "description": "Λίστα αρχείων σε αναλυτική μορφή, ταξινομημένη κατά ημερομηνία τροποποίησης και με αντίστροφη σειρά (τα παλαιότερα πρώτα):",
          "command": "ls {{[-ltr|-lt --reverse]}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L32"
        },
        {
          "description": "Λίστα μόνο των κατάλογων:",
          "command": "ls {{[-d|--directory]}} */",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.el/common/ls.md#L36"
        }
