      "locale": "tr",
      "sourceLocale": "tr",
      "name": "alias",
      "title": "alias",
      "summary": "Takma adlar/kısayollar (bir komut dizesi ile değiştirilen sözcükler) oluşturur. Kısayollar, kabuğun yapılandırma dosyasında (örneğin `~/.bashrc`) tanımlanmadığı sürece geçerli kabuk oturumuyla birlikte sona erer. Ayrıca bakınız: `unalias`.",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Tüm kısayolları listele:",
          "command": "alias",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/alias.md#L10"
        },
        {
          "description": "Genel bir kısayol oluştur:",
          "command": "alias {{kelime}}=\"{{komut}}\"",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/alias.md#L14"
        },
        {
          "description": "Bir kısayolun verildigi komutu göster:",
          "command": "alias {{kelime}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/alias.md#L18"
        },
        {
          "description": "Bir kısayolu kaldır:",
          "command": "unalias {{kelime}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/alias.md#L22"
        },
        {
          "description": "`rm`'yi interaktif bir komuta dönüştür:",
          "command": "alias rm=\"rm --interactive\"",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/alias.md#L26"
        },
        {
          "description": "`la`'yi `ls --all` için kısayol olarak oluştur:",
          "command": "alias la=\"ls --all\"",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/alias.md#L30"
        }
      ],
