      "exampleCount": 8,
      "examples": [
        {
          "description": "Uzak bir sunucuya bağlan:",
          "command": "ssh {{kullanici}}@{{uzak_sunucu}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/ssh.md#L9"
        },
        {
          "description": "Belirli bir kimlik dosyası (özel anahtar) ile uzak sunucuya bağlan:",
          "command": "ssh {{kullanici}}@{{uzak_sunucu}} -i {{anahtar/dosyasi/yolu}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/ssh.md#L13"
        },
        {
          "description": "`10.0.0.1` IP adresli uzak sunucuya belirli bir port ile bağlan (Not: `10.0.0.1` kısaltılarak `10.1` yazılabilir):",
          "command": "ssh {{kullanici}}@10.0.0.1 -p {{2222}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/ssh.md#L17"
