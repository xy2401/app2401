      "id": "tldr--8b8aa6427234",
      "canonicalPath": "common/awk.md",
      "locale": "tr",
      "sourceLocale": "tr",
      "name": "awk",
      "title": "awk",
      "summary": "Dosyalar üzerinde çalışmak için çok yönlü bir programlama dili. Ayrıca bakınız: `gawk`.",
      "platform": "cross-platform",
      "softwareIds": [
        "awk--72559405",
        "gawk--3d177db2",
        "gow--4cb149e7"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Boşlukla ayrılmış bir dosyada beşinci sütunu (alan olarak da bilinir) yazdır:",
          "command": "awk '{print $5}' {{dosya/yolu/dosya}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L9"
        },
        {
          "description": "Boşlukla ayrılmış bir dosyada \"foo\" içeren satırların ikinci sütununu yazdır:",
          "command": "awk '/{{foo}}/ {print $2}' {{dosya/yolu/dosya}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L13"
        },
        {
          "description": "Alan ayırıcı olarak (boşluk yerine) virgül kullanarak dosyadaki her satırın son sütununu yazdır:",
          "command": "awk -F ',' '{print $NF}' {{dosya/yolu/dosya}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L17"
        },
        {
          "description": "Bir dosyanın ilk sütunundaki değerleri topla ve toplamı yazdır:",
          "command": "awk '{s+=$1} END {print s}' {{dosya/yolu/dosya}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L21"
        },
        {
          "description": "İlk satırdan başlayarak her üçüncü satırı yazdır:",
          "command": "awk 'NR%3==1' {{dosya/yolu/dosya}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L25"
        },
        {
          "description": "Koşullara göre farklı değerler yazdır:",
          "command": "awk '{if ($1 == \"foo\") print \"Tam eşleşme foo\"; else if ($1 ~ \"bar\") print \"Kısmi eşleşme çubuğu\"; else print \"Baz\"}' {{dosya/yolu/dosya}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L29"
        },
        {
          "description": "10. sütun değerinin belirtilen değere eşit olduğu tüm satırları yazdır:",
          "command": "awk '($10 == value)'",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L33"
        },
        {
          "description": "10. sütun değeri min ile max arasında olan tüm satırları yazdır:",
          "command": "awk '($10 >= min_value && $10 <= max_value)'",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/awk.md"
