      "id": "tldr--85c1b3d29014",
      "canonicalPath": "linux/ncat.md",
      "locale": "tr",
      "sourceLocale": "tr",
      "name": "ncat",
      "title": "ncat",
      "summary": "Bir ağ üzerinden veriyi okuyun, yazın, yeniden yönlendirin veya şifreleyin. `netcat`/`nc` adlı benzer bir yardımcı programın alternatifi.",
      "platform": "linux",
      "softwareIds": [
        "nmap--8f5f1798"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Belirtilen porttaki girdiyi dinle ve belirtilen dosyaya yaz:",
          "command": "ncat {{[-l|--listen]}} {{port}} > {{dosya/yolu}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/ncat.md#L9"
        },
        {
          "description": "Çoklu bağlantıları kabul et ve ncat'i bağlantılar kapandıktan sonra da açık tut:",
          "command": "ncat {{[-lk|--listen --keep-open]}} {{port}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/ncat.md#L13"
        },
        {
          "description": "Belirtilen dosyanın çıktısını al ve belirtilen bilgisayardaki belirtilen porta yaz:",
          "command": "ncat < {{dosya/yolu}} {{bilgisayar}} {{port}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/ncat.md#L17"
        },
        {
          "description": "Trafik içeriğinin tespit edilmesini önleyerek şifreli bir kanalda çoklu bağlantıları kabul edin:",
          "command": "ncat --ssl {{[-k|--keep-open]}} {{[-l|--listen]}} {{port}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/ncat.md#L21"
        },
        {
          "description": "Açık `ncat` bağlantısını SSL üzerinden bağlayın:",
          "command": "ncat --ssl {{bilgisayar}} {{port}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/ncat.md#L25"
        },
