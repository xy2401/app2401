      "name": "grub-install",
      "title": "grub-install",
      "summary": "Bir cihaza GRUB kurun.",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Bir BIOS sisteme GRUB kurun:",
          "command": "sudo grub-install {{cihaz/yolu}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/grub-install.md#L8"
        },
        {
          "description": "GRUB'u, bir BIOS sistemine belirtilen mimari ile kurun:",
          "command": "sudo grub-install --target {{i386-pc}} {{cihaz/yolu}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/grub-install.md#L12"
        },
        {
          "description": "Bir UEFI sisteme GRUB kurun:",
          "command": "sudo grub-install --efi-directory {{efi/dizini/yolu}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/grub-install.md#L16"
        },
        {
          "description": "GRUB'u, UEFI bir sisteme belirtilen mimari ve belirtilen önyükleme menü yazısı ile kurun:",
          "command": "sudo grub-install --target {{x86_64-efi}} --efi-directory {{efi/dizin/yolu}} --bootloader-id {{GRUB}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/grub-install.md#L20"
        },
        {
          "description": "GRUB'u, yükleme öncesi özel modüller ile kurun:",
          "command": "sudo grub-install --target {{x86_64-efi}} --efi-directory {{efi/dizin/yolu}} --modules \"{{part_gpt part_msdos}}\"",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/grub-install.md#L24"
        },
        {
          "description": "Yardımı görüntüleyin:",
          "command": "grub-install {{[-?|--help]}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/grub-install.md#L28"
        }
