      "name": "wget",
      "title": "wget",
      "summary": "Web'den dosya indirir. HTTP, HTTPS ve FTP protokollerini destekler. Ayrıca bakınız: `wcurl`, `curl`.",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "unxutils--5bef4004",
        "wget--17a14d51",
        "wget--5239fb4d",
        "wget120--17a14d51"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Bir URL'nin içeriğini bir dosyaya indir (bu örnekte dosya adı \"foo\"):",
          "command": "wget {{https://example.com/foo}}",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/wget.md#L10"
        },
        {
          "description": "Bir URL'nin içeriğini belirtilen dosya adıyla indir (bu örnekte \"bar\"):",
          "command": "wget {{[-O|--output-document]}} {{bar}} {{https://example.com/foo}}",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/wget.md#L14"
        },
        {
          "description": "Tek bir web sayfasını ve tüm kaynaklarını (betikler, stil dosyaları, görseller vb.) istekler arasında 3 saniyelik aralıklarla indir:",
          "command": "wget {{[-pkw|--page-requisites --convert-links --wait]}} 3 {{https://example.com/bir_sayfa.html}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/wget.md#L18"
        },
        {
          "description": "Bir dizindeki ve alt dizinlerindeki tüm dosyaları indir (gömülü sayfa öğelerini indirmez):",
          "command": "wget {{[-mnp|--mirror --no-parent]}} {{https://example.com/bir_dizin/}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/wget.md#L22"
        },
        {
          "description": "İndirme hızını ve bağlantı yeniden deneme sayısını sınırla:",
          "command": "wget --limit-rate {{300k}} {{[-t|--tries]}} {{100}} {{https://example.com/bir_dizin/}}",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/wget.md#L26"
