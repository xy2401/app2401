      "exampleCount": 8,
      "examples": [
        {
          "description": "Kullanılan önyüklemeden 3 öncelik seviyesine sahip tüm mesajları(hataları) gösterin:",
          "command": "journalctl {{[-b|--boot]}} {{[-p|--priority]}} 3",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/journalctl.md#L9"
        },
        {
          "description": "2 günden eski olan günlük kayıtlarını silin:",
          "command": "journalctl --vacuum-time 2d",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/journalctl.md#L13"
        },
        {
          "description": "Yeni mesajların sadece son 'n' satırlarını gösterin ve takip edin (geleneksel syslog için `tail -f` benzeri):",
          "command": "journalctl {{[-n|--lines]}} {{n}} {{[-f|--follow]}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/journalctl.md#L17"
        },
        {
          "description": "Belirli bir birime ait tüm mesajları göster:",
          "command": "journalctl {{[-u|--unit]}} {{birim}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/journalctl.md#L21"
        },
        {
          "description": "Belirli bir birimin son başlatılmasından bu yana tüm günlük kayıtlarını göster:",
          "command": "journalctl _SYSTEMD_INVOCATION_ID=$(systemctl show --value --property=InvocationID {{birim}})",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/journalctl.md#L25"
        },
        {
          "description": "Belirli bir zaman aralığındaki mesajları filtrele (zaman damgası veya \"dün\" gibi yer tutucular):",
