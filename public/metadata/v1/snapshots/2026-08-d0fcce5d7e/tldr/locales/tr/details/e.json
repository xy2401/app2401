      "examples": [
        {
          "description": "Belirtilen dizindeki tüm dosyalarda `fzf`'yi başlat:",
          "command": "find {{dosya/yolu/dizin}} -type f | fzf",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/fzf.md#L9"
        },
        {
          "description": "Çalışan süreçler için `fzf`'yi başlat:",
          "command": "ps aux | fzf",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/fzf.md#L13"
        },
        {
          "description": "`<Shift Tab>` ile birden çok dosya seç ve bir dosyaya yaz:",
          "command": "find {{dosya/yolu/dizin}} -type f | fzf {{[-m|--multi]}} > {{dosya/yolu/dosya}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/fzf.md#L17"
        },
        {
          "description": "`fzf`'yi belirli bir sorgu ile başlat:",
          "command": "fzf {{[-q|--query]}} \"{{sorgu}}\"",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/fzf.md#L21"
        },
        {
          "description": "`core` ile başlayan ve `go`, `rb` veya `py` ile biten girişlerde `fzf`'yi başlat:",
          "command": "fzf {{[-q|--query]}} \"^core go$ | rb$ | py$\"",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/fzf.md#L25"
        },
        {
          "description": "PYC ile eşleşmeyen ve Travis'e tam olarak eşleşen girişlerde `fzf`'yi başlat:",
          "command": "fzf {{[-q|--query]}} '!pyc travis'",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/common/fzf.md#L29"
