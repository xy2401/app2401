      "id": "tldr--0aac4079f687",
      "canonicalPath": "linux/xrandr.md",
      "locale": "tr",
      "sourceLocale": "tr",
      "name": "xrandr",
      "title": "xrandr",
      "summary": "Bir ekran için boyut, yön ve/veya çıkış yansımasını ayarla.",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Sistemin mevcut durumunu göster (bilinen ekranlar, çözünürlükler, ...):",
          "command": "xrandr {{[-q|--query]}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/xrandr.md#L8"
        },
        {
          "description": "Bağlantısı kesilmiş çıkışları devre dışı bırak ve bağlanmış olanları varsayılan ayarlar ile devreye sok:",
          "command": "xrandr --auto",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/xrandr.md#L12"
        },
        {
          "description": "DisplayPort 1'in çözünürlük ve yenileme hızını 1920x1080, 60Hz olarak değiştir:",
          "command": "xrandr --output {{DP1}} --mode {{1920x1080}} --rate {{60}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/xrandr.md#L16"
        },
        {
          "description": "HDMI2'nin çözünürlüğünü 1280x1024'e değiştirip, DP1'in sağına koy:",
          "command": "xrandr --output {{HDMI2}} --mode {{1280x1024}} --right-of {{DP1}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/xrandr.md#L20"
        },
        {
          "description": "VGA1 çıkışını devre dışı bırak:",
          "command": "xrandr --output {{VGA1}} --off",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/xrandr.md#L24"
        },
        {
          "description": "LVDS1 için parlaklığı 50% yap:",
          "command": "xrandr --output {{LVDS1}} --brightness {{0.5}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/xrandr.md#L28"
        }
      ],
