      "id": "tldr--1455c568ab06",
      "canonicalPath": "linux/pacman-mirrors.md",
      "locale": "tr",
      "sourceLocale": "tr",
      "name": "pacman-mirrors",
      "title": "pacman-mirrors",
      "summary": "Manjaro Linux için pacman aynalistesi oluşturucu. pacman-mirrors'ın çalıştırıldığı her vakit, E`sudo pacman -Syyu` komutu ile veritabanının senkronize edilmesi ve sistemin güncellenmesi gerekir. Ayrıca bakınız: `pacman`.",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "Varsayılan ayarlar ile bir aynalistesi oluştur:",
          "command": "sudo pacman-mirrors --fasttrack",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/pacman-mirrors.md#L10"
        },
        {
          "description": "Mevcut aynaların durumunu göster:",
          "command": "pacman-mirrors --status",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/pacman-mirrors.md#L14"
        },
        {
          "description": "Mevcut dalı göster:",
          "command": "pacman-mirrors --get-branch",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/pacman-mirrors.md#L18"
        },
        {
          "description": "Farklı bir dala geç:",
          "command": "sudo pacman-mirrors --api --set-branch {{stabil|instabil|test_ediliyor}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/pacman-mirrors.md#L22"
        },
        {
          "description": "Sadece IP adresinin bulunduğu ülkenin aynalarını kullanarak bir aynalistesi oluştur:",
          "command": "sudo pacman-mirrors --geoip",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.tr/linux/pacman-mirrors.md#L26"
        }
