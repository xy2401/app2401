      "name": "echo",
      "title": "echo",
      "summary": "与えられた引数を表示します。 参照: `printf`。",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "テキストメッセージを印刷する。備考: 引用符は任意:",
          "command": "echo \"{{Hello World}}\"",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/echo.md#L9"
        },
        {
          "description": "環境変数のメッセージを表示する:",
          "command": "echo \"{{パスは $PATH です。}}\"",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/echo.md#L13"
        },
        {
          "description": "メッセージを最後の改行なしで表示する:",
          "command": "echo -n \"{{Hello World}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/echo.md#L17"
        },
        {
          "description": "ファイルにメッセージを追加する:",
          "command": "echo \"{{Hello World}}\" >> {{ファイル.txt}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/echo.md#L21"
        },
        {
          "description": "バックスラッシュエスケープ（特殊文字）の解釈を可能にする:",
          "command": "echo -e \"{{カラム 1\\tカラム 2}}\"",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/echo.md#L25"
        }
