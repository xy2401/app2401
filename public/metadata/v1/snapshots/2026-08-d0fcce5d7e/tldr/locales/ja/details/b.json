      "id": "tldr--21c6ca4d075a",
      "canonicalPath": "common/ssh-keygen.md",
      "locale": "ja",
      "sourceLocale": "ja",
      "name": "ssh-keygen",
      "title": "ssh-keygen",
      "summary": "認証やパスワード不要のログインなどに使われるSSHキーを生成します。 参照: `ssh-copy-id`。",
      "platform": "cross-platform",
      "softwareIds": [
        "git-with-openssh--49faf317",
        "mls-software-openssh--6b012d8a",
        "openssh--7291a89e"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "対話的にキーを生成します:",
          "command": "ssh-keygen",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L9"
        },
        {
          "description": "32ラウンド回数の鍵導出関数でed25519鍵を生成し、特定のファイルに保存する:",
          "command": "ssh-keygen -t {{ed25519}} -a {{32}} -f {{~/.ssh/filename}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L13"
        },
        {
          "description": "Eメールをコメントとして、RSA 4096ビット鍵を生成する:",
          "command": "ssh-keygen -t {{rsa}} -b {{4096}} -C \"{{comment|email}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L17"
        },
        {
          "description": "known_hostsファイルからホストの鍵を削除する (既知のホストが新しい鍵を持つ場合に便利):",
          "command": "ssh-keygen -R {{remote_host}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L21"
        },
        {
          "description": "鍵のフィンガープリントをMD5 Hexで取得する:",
          "command": "ssh-keygen -l -E {{md5}} -f {{~/.ssh/filename}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L25"
        },
        {
          "description": "鍵のパスワードを変更する:",
          "command": "ssh-keygen -p -f {{~/.ssh/filename}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L29"
        },
        {
          "description": "鍵の形式を変更する (たとえば OPENSSH 形式から PEM 形式へ):",
          "command": "ssh-keygen -p -N \"\" -m {{PEM}} -f {{~/.ssh/OpenSSH_private_key}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L33"
        },
        {
          "description": "秘密鍵から公開鍵を取得する:",
          "command": "ssh-keygen -y -f {{~/.ssh/OpenSSH_private_key}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ssh-keygen.md"
    },
