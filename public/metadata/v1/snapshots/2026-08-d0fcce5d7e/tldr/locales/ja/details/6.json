      "canonicalPath": "common/gpg.md",
      "locale": "ja",
      "sourceLocale": "ja",
      "name": "gpg",
      "title": "gpg",
      "summary": "GNU Privacy Guard。 参照: `sq`。",
      "platform": "cross-platform",
      "softwareIds": [
        "git--49faf317",
        "git-with-openssh--49faf317",
        "gnupg1--fd387128"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "GPGの公開鍵と秘密鍵を対話的に作成する:",
          "command": "gpg {{[--full-gen-key|--full-generate-key]}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/gpg.md#L9"
        },
        {
          "description": "暗号化せずに `doc.txt` に署名する (出力を `doc.txt.asc` に書き出す):",
          "command": "gpg --clearsign {{doc.txt}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/gpg.md#L13"
        },
        {
          "description": "alice@example.com と bob@example.com の `doc.txt` を暗号化して署名する (`doc.txt.gpg` に出力):",
          "command": "gpg {{[-es|--encrypt --sign]}} {{[-r|--recipient]}} {{alice@example.com}} {{[-r|--recipient]}} {{bob@example.com}} {{doc.txt}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/gpg.md#L17"
        },
        {
          "description": "パスフレーズのみで `doc.txt` を暗号化する (`doc.txt.gpg` に出力):",
          "command": "gpg {{[-c|--symmetric]}} {{doc.txt}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/gpg.md#L21"
        },
        {
          "description": "`doc.txt.gpg` を復号化する (`stdout` に出力):",
          "command": "gpg {{[-d|--decrypt]}} {{doc.txt.gpg}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/gpg.md#L25"
        },
        {
          "description": "公開鍵をインポートする:",
          "command": "gpg --import {{public.gpg}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/gpg.md#L29"
        },
        {
          "description": "alice@example.com 用に公開鍵をエクスポートする (`stdout` に出力):",
          "command": "gpg --export {{[-a|--armor]}} {{alice@example.com}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/gpg.md#L33"
