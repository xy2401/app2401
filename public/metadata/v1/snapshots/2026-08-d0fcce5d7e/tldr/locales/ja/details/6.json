      "id": "tldr--61466624cd4b",
      "canonicalPath": "common/ffmpeg.md",
      "locale": "ja",
      "sourceLocale": "ja",
      "name": "ffmpeg",
      "title": "ffmpeg",
      "summary": "動画変換ツールです。 参照: `gst-launch-1.0`。",
      "platform": "cross-platform",
      "softwareIds": [
        "ffmpeg--ccdc97f3",
        "ffmpeg-essentials--697bfe0d",
        "ffmpeg-gyan-nightly--048da560",
        "ffmpeg-nightly--048da560",
        "ffmpeg-shared-4-4-1--048da560",
        "ffmpeg-shared-nightly--048da560",
        "ffmpeg-shared-yt-dlp-nightly--c1834349",
        "ffmpeg-yt-dlp-nightly--c1834349",
        "imagemagick-ffmpeg--1a1f6843"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "ビデオからサウンドを抽出し、MP3 として保存:",
          "command": "ffmpeg -i {{path/to/video.mp4}} -vn {{path/to/sound.mp3}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L9"
        },
        {
          "description": "FLAC ファイルを Red Book CD フォーマット（44100kHz、16bit）にトランスコード:",
          "command": "ffmpeg -i {{path/to/input_audio.flac}} -ar 44100 -sample_fmt s16 {{path/to/output_audio.wav}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L13"
        },
        {
          "description": "ビデオを GIF として保存する。高さを 1000px に拡大縮小し、フレームレートを 15 に設定:",
          "command": "ffmpeg -i {{path/to/video.mp4}} {{[-vf|-filter:v]}} 'scale=-1:1000' -r 15 {{path/to/output.gif}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L17"
        },
        {
          "description": "番号付けされた画像（`frame_1.jpg`, `frame_2.jpg` など）を動画または GIF に結合:",
          "command": "ffmpeg -i {{path/to/frame_%d.jpg}} -f image2 {{video.mpg|video.gif}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L21"
        },
        {
          "description": "指定した開始時刻 mm:ss から終了時刻 mm2:ss2 までの動画をトリミング (最後までトリミングするには -to フラグを省略):",
          "command": "ffmpeg -i {{path/to/input_video.mp4}} -ss {{mm:ss}} -to {{mm2:ss2}} {{[-c|-codec]}} copy {{path/to/output_video.mp4}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L25"
        },
        {
          "description": "AAC Audio @ 128kbit、 h264 Video @ CRF 23 の設定で、 AVI 動画を MP4 に変換:",
          "command": "ffmpeg -i {{path/to/input_video}}.avi {{[-c|-codec]}}:a aac -b:a 128k {{[-c|-codec]}}:v libx264 -crf 23 {{path/to/output_video}}.mp4",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L29"
        },
        {
          "description": "音声やビデオストリームを再エンコードせずに、MKV ビデオを MP4 にリマックスする:",
          "command": "ffmpeg -i {{path/to/input_video}}.mkv {{[-c|-codec]}} copy {{path/to/output_video}}.mp4",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L33"
        },
        {
          "description": "MP4 ビデオを VP9 コーデックに変換する。最高の画質を得るには、CRF 値（推奨範囲 15-35）を使用し、-b:v は 0 でなければならない:",
          "command": "ffmpeg -i {{path/to/input_video}}.mp4 {{[-c|-codec]}}:v libvpx-vp9 -crf {{30}} -b:v 0 {{[-c|-codec]}}:a libopus -vbr on -threads {{number_of_threads}} {{path/to/output_video}}.webm",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/ffmpeg.md"
    },
