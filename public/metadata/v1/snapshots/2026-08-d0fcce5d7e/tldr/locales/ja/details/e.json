    {
      "id": "tldr--16ed77dea912",
      "canonicalPath": "common/chmod.md",
      "locale": "ja",
      "sourceLocale": "ja",
      "name": "chmod",
      "title": "chmod",
      "summary": "ファイルやディレクトリのアクセス権限を変更します。",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "ファイルを所有する [u]ser に、そのファイルを実行 ([x]ecute) する権限を付与する:",
          "command": "chmod u+x {{path/to/file}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L8"
        },
        {
          "description": "[u]ser に、ファイル/ディレクトリの 読み取り ([r]ead) と 書き込み ([w]rite) の権限を付与する:",
          "command": "chmod u+rw {{path/to/file_or_directory}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L12"
        },
        {
          "description": "[g]roup から 実行 (e[x]ecutable) 権限を削除する:",
          "command": "chmod g-x {{path/to/file}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L16"
        },
        {
          "description": "全て ([a]ll) のユーザに [r]ead と e[x]ecute の権限を付与する:",
          "command": "chmod a+rx {{path/to/file}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L20"
        },
        {
          "description": "(ファイル所有者のグループに属していない) その他のユーザ ([o]thers) に [g]roup と同じ権限を付与する:",
          "command": "chmod o=g {{path/to/file}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L24"
        },
        {
          "description": "その他のユーザ ([o]thers) から全ての権限を削除する:",
          "command": "chmod o= {{path/to/file}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L28"
        },
        {
          "description": "[g]roup と [o]thers に [w]rite 権限を再帰的に付与する:",
          "command": "chmod {{[-R|--recursive]}} g+w,o+w {{path/to/directory}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L32"
        },
        {
          "description": "全て ([a]ll) のユーザーに、ファイルへの [r]ead 権限と、ディレクトリ内のサブディレクトリへの e[X]ecute 権限を再帰的に付与する:",
          "command": "chmod {{[-R|--recursive]}} a+rX {{path/to/directory}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/chmod.md"
    },
