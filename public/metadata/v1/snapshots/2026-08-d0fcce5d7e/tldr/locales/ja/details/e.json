    {
      "id": "tldr--a5636b821400",
      "canonicalPath": "common/find.md",
      "locale": "ja",
      "sourceLocale": "ja",
      "name": "find",
      "title": "find",
      "summary": "ディレクトリツリー下のファイルやディレクトリを再帰的に検索します。 参照: `fd`。",
      "platform": "cross-platform",
      "softwareIds": [
        "findutils--1bc6b0b1",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004",
        "uutils-findutils--77d666d2"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "拡張子でファイル検索する:",
          "command": "find {{ルートパス}} -name '{{*.ext}}'",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L9"
        },
        {
          "description": "複数のパス/名前パターンに一致するファイルを検索する:",
          "command": "find {{ルートパス}} -path '{{*/path/*/*.ext}}' -or -name '{{*pattern*}}'",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L13"
        },
        {
          "description": "大文字小文字を区別しないモードで、指定された名前にマッチするディレクトリを検索する:",
          "command": "find {{ルートパス}} -type d -iname '{{*lib*}}'",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L17"
        },
        {
          "description": "特定のパスを除いて、与えられたパターンにマッチするファイルを検索する:",
          "command": "find {{ルートパス}} -name '{{*.py}}' -not -path '{{*/site-packages/*}}'",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L21"
        },
        {
          "description": "与えられたサイズ範囲にマッチするファイルを検索し、再帰的な深さを\"1\"に制限する:",
          "command": "find {{ルートパス}} -maxdepth 1 -size {{+500k}} -size {{-10M}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L25"
        },
        {
          "description": "各ファイルに対してコマンドを実行する (ファイル名にアクセスするにはコマンド内で`{}`を使用):",
          "command": "find {{ルートパス}} -name '{{*.ext}}' -exec {{wc -l}} {} \\;",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L29"
        },
        {
          "description": "今日変更されたすべてのファイルを検索し、その結果を引数として1つのコマンドに渡す:",
          "command": "find {{ルートパス}} -daystart -mtime {{-1}} -exec {{tar -cvf archive.tar}} {} \\+",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L33"
        },
        {
          "description": "空のファイルまたはディレクトリを検索し、冗長に削除する:",
          "command": "find {{ルートパス}} -type {{f|d}} -empty -delete -print",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/find.md"
    },
