    {
      "id": "tldr--77e8d5ad7f49",
      "canonicalPath": "common/wget.md",
      "locale": "ja",
      "sourceLocale": "ja",
      "name": "wget",
      "title": "wget",
      "summary": "Webからファイルをダウンロードします。 HTTP, HTTPS, そして FTP をサポートします。 参照: `wcurl`, `curl`。",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "unxutils--5bef4004",
        "wget--17a14d51",
        "wget--5239fb4d",
        "wget120--17a14d51"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "URLの内容を、ファイルにダウンロードする (この場合 \"foo\" と言う名前で):",
          "command": "wget {{https://example.com/foo}}",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L10"
        },
        {
          "description": "URLの内容を、ファイルにダウンロードする (この場合 \"bar\" と言う名前で):",
          "command": "wget {{[-O|--output-document]}} {{bar}} {{https://example.com/foo}}",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L14"
        },
        {
          "description": "1つのウェブページと、その全てのリソースを、リクエスト間隔を3秒にしてダウンロードする (スクリプト、スタイルシート、画像など):",
          "command": "wget {{[-pkw|--page-requisites --convert-links --wait]}} 3 {{https://example.com/somepage.html}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L18"
        },
        {
          "description": "ディレクトリと、そのサブディレクトリ内のリストされたファイルを、全てダウンロードする (埋め込まれたページ要素はダウンロードしない):",
          "command": "wget {{[-mnp|--mirror --no-parent]}} {{https://example.com/somepath/}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L22"
        },
        {
          "description": "ダウンロード速度と接続再試行回数を制限する:",
          "command": "wget --limit-rate {{300k}} {{[-t|--tries]}} {{100}} {{https://example.com/somepath/}}",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L26"
        },
        {
          "description": "HTTPサーバーからBasic認証を使って、ファイルをダウンロードする (FTPも機能する):",
          "command": "wget --user {{ユーザ名}} --password {{パスワード}} {{https://example.com}}",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L30"
        },
        {
          "description": "未完了のダウンロードを続行する:",
          "command": "wget {{[-c|--continue]}} {{https://example.com}}",
          "line": 34,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L34"
        },
        {
          "description": "テキストファイルに格納されている全てのURLを、特定のディレクトリにダウンロードする:",
          "command": "wget {{[-P|--directory-prefix]}} {{path/to/directory}} {{[-i|--input-file]}} {{URLs.txt}}",
          "line": 38,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md#L38"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/wget.md"
    },
