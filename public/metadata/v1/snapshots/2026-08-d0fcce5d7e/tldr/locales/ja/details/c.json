      "examples": [
        {
          "description": "各ファイルに `stdin` をコピーし、`stdout` にもコピーする:",
          "command": "echo \"example\" | tee {{path/to/file}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/tee.md#L8"
