          "command": "bat {{[-L|--list-languages]}}",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/bat.md#L30"
        }
