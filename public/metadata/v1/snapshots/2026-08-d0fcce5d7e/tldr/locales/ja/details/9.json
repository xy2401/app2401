        "git-with-openssh--49faf317",
        "git-without-openssh--49faf317",
        "git19--a73464fb",
        "mingit-busybox--a73464fb"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "メッセージと共に、ステージ済のファイルをリポジトリにコミットする:",
          "command": "git commit {{[-m|--message]}} \"{{メッセージ}}\"",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/git-commit.md#L8"
        },
        {
          "description": "ファイルから読みとったメッセージと共に、ステージ済のファイルをコミットする:",
          "command": "git commit {{[-F|--file]}} {{コミットメッセージが書かれたファイルへのパス}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/git-commit.md#L12"
        },
        {
          "description": "変更されたファイルを全て自動的にステージし、メッセージと共にコミットする:",
          "command": "git commit {{[-a|--all]}} {{[-m|--message]}} \"{{メッセージ}}\"",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/git-commit.md#L16"
        },
        {
          "description": "今のステージ済の変更を最後のコミットに付け足し、コミットハッシュを変更する:",
          "command": "git commit --amend",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ja/common/git-commit.md#L20"
        },
        {
