    {
      "id": "tldr--61466624cd4b",
      "canonicalPath": "common/ffmpeg.md",
      "locale": "ne",
      "sourceLocale": "ne",
      "name": "ffmpeg",
      "title": "ffmpeg",
      "summary": "भिडियो रूपान्तरण उपकरण। हेर्नुहोस् पनि: `gst-launch-1.0`।",
      "platform": "cross-platform",
      "softwareIds": [
        "ffmpeg--ccdc97f3",
        "ffmpeg-essentials--697bfe0d",
        "ffmpeg-gyan-nightly--048da560",
        "ffmpeg-nightly--048da560",
        "ffmpeg-shared-4-4-1--048da560",
        "ffmpeg-shared-nightly--048da560",
        "ffmpeg-shared-yt-dlp-nightly--c1834349",
        "ffmpeg-yt-dlp-nightly--c1834349",
        "imagemagick-ffmpeg--1a1f6843"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "भिडियोबाट ध्वनि निकाल्नुहोस् र MP3 को रूपमा सेभ गर्नुहोस:",
          "command": "ffmpeg -i {{भिडियो.mp4}} -vn {{ध्वनि}}.mp3",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L9"
        },
        {
          "description": "भिडियोको उचाइ 1000px मा स्केल गर्दै र फ्रेमरेटलाई 15 राखेर GIF को रूपमा सेभ गर्नुहोस:",
          "command": "ffmpeg -i {{भिडियो.mp4}} {{[-vf|-filter:v]}} 'scale=-1:1000' -r 15 {{आउटपुट.gif}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L13"
        },
        {
          "description": "अंकित छविहरूलाइ(`फ्रेम_1.jpg`, `फ्रेम_2.jpg`, आदि) भिडियो वा GIF मा जोड्नुहोस:",
          "command": "ffmpeg -i {{फ्रेम_%d.jpg}} -f image2 {{भिडियो.mpg|भिडियो.gif}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L17"
        },
        {
          "description": "भिडियोको mm:ss बाट एकल फ्रेम निकाल्नुहोस् र यसलाई 128x128 रिजोल्युसनको छविको रूपमा सेभ गर्नुहोस्:",
          "command": "ffmpeg -ss {{mm:ss}} -i {{भिडियो.mp4}} -frames 1 -s {{128x128}} -f image2 {{छवि.png}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L21"
        },
        {
          "description": "दिइएको सुरु समय mm:ss देखि अन्त्यसमय mm2:ss2 सम्म भिडियोलाइ काट्नुहोस (अन्त्य सम्म नै काट्नलाई -to फ्ल्याग हटाउनुहोस्):",
          "command": "ffmpeg -ss {{mm:ss}} -to {{mm2:ss2}} -i {{भिडियो.mp4}} {{[-c|-codec]}} copy {{आउटपुट.mp4}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L25"
        },
        {
          "description": "AVI भिडियोलाई MP4 मा रूपान्तरण गर्नुहोस्। अडियोको 128kbit बिटरेट राखेर AAC मा, भिडियोको CRF 23 राखेर h264 मा:",
          "command": "ffmpeg -i {{इनपुट_भिडियो}}.avi {{[-c|-codec]}}:a aac -b:a 128k {{[-c|-codec]}}:v libx264 -crf 23 {{आउटपुट_भिडियो}}.mp4",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L29"
        },
        {
          "description": "MKV भिडियोको अडियो वा भिडियो स्ट्रिमहरू पुन: एन्कोडिङ नगरी हानिरहित ढाँचामा MP4 मा बदल्नुहोस:",
          "command": "ffmpeg -i {{इनपुट_भिडियो}}.mkv {{[-c|-codec]}} copy {{आउटपुट_भिडियो}}.mp4",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L33"
        },
        {
          "description": "MP4 भिडियोलाई VP9 कोडेकमा रूपान्तरण गर्नुहोस्। उत्कृष्ट गुणस्तरको लागि, CRF फ्ल्यागको प्रयोग गर्नुहोस् (सिफारिस गरिएको दायरा 15-35) र `-b:v 0` पनि प्रयोग गर्नुहोस्:",
          "command": "ffmpeg -i {{इनपुट_भिडियो}}.mp4 {{[-c|-codec]}}:v libvpx-vp9 -crf {{30}} -b:v 0 {{[-c|-codec]}}:a libopus -vbr on -threads {{थ्रेड_संख्या}} {{आउटपुट_भिडियो}}.webm",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ffmpeg.md"
    },
