      "examples": [
        {
          "description": "एक लाइनमा एउटा वस्तु देखाएर फाइलहरू देखाउनुहोस्:",
          "command": "ls -1",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ls.md#L8"
        },
        {
          "description": "लुकेका फाइलहरू सहित सबै फाइलहरू देखाउनुहोस्:",
          "command": "ls {{[-a|--all]}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ls.md#L12"
        },
        {
          "description": "डाइरेक्टरी नामहरूको अन्त्यमा '/' थपेर फाइलहरू देखाउनुहोस्:",
          "command": "ls {{[-F|--classify]}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ls.md#L16"
        },
        {
          "description": "सबै फाइलहरूको लामो ढाँचाको सूची देखाउनुहोस् (अनुमतिहरू, स्वामित्व, साइज, र परिमार्जन मिति):",
          "command": "ls {{[-la|-l --all]}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ls.md#L20"
        },
        {
          "description": "लामो ढाँचामा सूची देखाउनुहोस् जहाँ साइज मानिसले पढ्न सक्ने एकाइहरूको ढाँचामा प्रदर्शित हुन्छ (KiB, MiB, GiB):",
          "command": "ls {{[-lh|-l --human-readable]}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ls.md#L24"
        },
        {
          "description": "लामो ढाँचामा फाइलहरू देखाउनुहोस् जुन साइज अनुसार क्रमबद्ध छन् (घट्दो क्रममा):",
          "command": "ls {{[-lSR|-lS --recursive]}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ls.md#L28"
        },
        {
          "description": "सबै फाइलहरूलाई लामो ढाँचामा देखाउनुहोस् जुन परिमार्जन मितिद्वारा क्रमबद्ध गरिएको छ (सबैभन्दा पुरानो पहिलो):",
          "command": "ls {{[-ltr|-lt --reverse]}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ne/common/ls.md#L32"
        },
