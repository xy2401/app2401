  "items": [
    {
      "id": "tldr--079015c65387",
      "canonicalPath": "windows/doskey.md",
      "locale": "ta",
      "sourceLocale": "ta",
      "name": "doskey",
      "title": "doskey",
      "summary": "மேக்ரோக்கள், விண்டோஸ் கட்டளைகள் மற்றும் கட்டளை வரிகளை நிர்வகிக்கவும்.",
      "platform": "windows",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "கிடைக்கக்கூடிய மேக்ரோக்களை பட்டியலிடுங்கள்:",
          "command": "doskey /macros",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md#L8"
        },
        {
          "description": "புதிய மேக்ரோவை உருவாக்கவும்:",
          "command": "doskey {{பெயர்}} = \"{{கட்டளை}}\"",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md#L12"
        },
        {
          "description": "ஒரு குறிப்பிட்ட இயங்கக்கூடியவைக்கு ஒரு புதிய மேக்ரோவை உருவாக்கவும்:",
          "command": "doskey /exename={{இயங்கக்கூடியவை}} {{பெயர்}} = \"{{கட்டளை}}\"",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md#L16"
        },
        {
          "description": "ஒரு மேக்ரோவை அகற்று:",
          "command": "doskey {{பெயர்}} =",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md#L20"
        },
        {
          "description": "நினைவகத்தில் சேமிக்கப்பட்ட அனைத்து கட்டளைகளையும் காண்பி:",
          "command": "doskey /history",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md#L24"
        },
        {
          "description": "பெயர்வுத்திறனுக்காக மேக்ரோக்களை ஒரு கோப்பில் சேமிக்கவும்:",
          "command": "doskey /macros > {{macinit}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md#L28"
        },
        {
          "description": "ஒரு கோப்பிலிருந்து மேக்ரோக்களை ஏற்றவும்:",
          "command": "doskey /macrofile = {{macinit}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md#L32"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/doskey.md"
    },
