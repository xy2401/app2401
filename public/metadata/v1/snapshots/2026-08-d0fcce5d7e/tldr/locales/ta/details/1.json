    {
      "id": "tldr--5559dcfa101d",
      "canonicalPath": "common/g++.md",
      "locale": "ta",
      "sourceLocale": "ta",
      "name": "g++",
      "title": "g++",
      "summary": "C++ மூலக் கோப்புகளைத் தொகுக்கவும். GCC (GNU கம்பைலர் சேகரிப்பு) இன் ஒரு பகுதி.",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "இயங்கக்கூடிய பைனரியில் ஒரு மூலக் குறியீடு கோப்பை தொகுக்கவும்:",
          "command": "g++ {{மூலம்1.cpp/பாதை மூலம்2.cpp/பாதை ...}} {{[-o|--output]}} {{வெளியீடு_இயங்கக்கூடியது/பாதை}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/g%2B%2B.md#L9"
        },
        {
          "description": "அனைத்து பிழைகள் மற்றும் எச்சரிக்கைகள் செயல்படுத்தவும்:",
          "command": "g++ {{மூலம்.cpp/பாதை}} -Wall {{[-o|--output]}} {{வெளியீடு_இயங்கக்கூடியது/பாதை}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/g%2B%2B.md#L13"
        },
        {
          "description": "பொதுவான எச்சரிக்கைகளைக் காட்டு, வெளியீட்டில் சின்னங்களைப் பிழைத்திருத்தம் செய், பின்னர் பிழைத்திருத்தத்தைப் பாதிக்காமல் மேம்படுத்து:",
          "command": "g++ {{மூலம்.cpp/பாதை}} -Wall {{[-g|--debug]}} -Og {{[-o|--output]}} {{வெளியீடு_இயங்கக்கூடியது/பாதை}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/g%2B%2B.md#L17"
        },
        {
          "description": "(C++98/C++11/C++14/C++17) தொகுக்க ஒரு மொழித் தரநிலையைத் தேர்வு செய்யவும்:",
          "command": "g++ {{மூலம்.cpp/பாதை}} -std={{c++98|c++11|c++14|c++17}} {{[-o|--output]}} {{வெளியீடு_இயங்கக்கூடியது/பாதை}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/g%2B%2B.md#L21"
        },
        {
          "description": "மூலக் கோப்பை விட வேறு பாதையில் அமைந்துள்ள நூலகங்களைச் சேர்க்கவும்:",
          "command": "g++ {{மூலம்.cpp/பாதை}} {{[-o|--output]}} {{வெளியீடு_இயங்கக்கூடியது/பாதை}} -I{{தலைப்பு/பாதை}} -L{{நூலகம்/பாதை}} -l{{நூலகம்_பெயர்}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/g%2B%2B.md#L25"
        },
        {
          "description": "பல மூலக் குறியீடு கோப்புகளை ஒரு இயங்கக்கூடிய பைனரியில் தொகுத்து இணைக்கவும்:",
          "command": "g++ {{[-c|--compile]}} {{மூலம்_1.cpp/பாதை மூலம்_2.cpp/பாதை ...}} && g++ {{[-o|--output]}} {{வெளியீடு_செயல்படுத்தக்கூடியது/பாதை}} {{மூலம்_1.o/பாதை மூலம்_2.o/பாதை ...}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/g%2B%2B.md#L29"
        },
