    {
      "id": "tldr--73d7e3efc9f9",
      "canonicalPath": "osx/uname.md",
      "locale": "ta",
      "sourceLocale": "ta",
      "name": "uname",
      "title": "uname",
      "summary": "தற்போதைய இயந்திரம் மற்றும் அதில் இயங்கும் இயக்க முறைமை பற்றிய விவரங்களை அச்சிடவும். குறிப்பு: இயக்க முறைமை பற்றிய கூடுதல் தகவலுக்கு, `sw_vers` கட்டளையை முயற்சிக்கவும்.",
      "platform": "macos",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "கர்னல் பெயரை அச்சிடவும்:",
          "command": "uname",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/osx/uname.md#L9"
        },
        {
          "description": "கணினி கட்டமைப்பு மற்றும் செயலி தகவலை அச்சிடவும்:",
          "command": "uname -mp",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/osx/uname.md#L13"
