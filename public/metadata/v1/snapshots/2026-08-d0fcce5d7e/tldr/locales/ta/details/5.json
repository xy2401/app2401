    {
      "id": "tldr--00df5d8b81dd",
      "canonicalPath": "windows/cmstp.md",
      "locale": "ta",
      "sourceLocale": "ta",
      "name": "cmstp",
      "title": "cmstp",
      "summary": "இணைப்பு சேவை சுயவிவரங்களை நிர்வகிப்பதற்கான கட்டளை வரி கருவி.",
      "platform": "windows",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "ஒரு குறிப்பிட்ட சுயவிவரத்தை நிறுவவும்:",
          "command": "cmstp \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L8"
        },
        {
          "description": "டெஸ்க்டாப் குறுக்குவழியை உருவாக்காமல் நிறுவவும்:",
          "command": "cmstp /ns \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L12"
        },
        {
          "description": "சார்புகளை சரிபார்க்காமல் நிறுவவும்:",
          "command": "cmstp /nf \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L16"
        },
        {
          "description": "தற்போதைய பயனருக்கு மட்டும் நிறுவவும்:",
          "command": "cmstp /su \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L20"
        },
        {
          "description": "அனைத்து பயனர்களுக்கும் நிறுவவும் (நிர்வாக சலுகைகள் தேவை):",
          "command": "cmstp /au \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L24"
        },
        {
          "description": "எந்த அறிவுறுத்தலும் இல்லாமல் அமைதியாக நிறுவவும்:",
          "command": "cmstp /s \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L28"
        },
        {
          "description": "குறிப்பிட்ட சுயவிவரத்தை நிறுவல் நீக்கவும்:",
          "command": "cmstp /u \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L32"
        },
        {
          "description": "உறுதிப்படுத்தல் அறிவுறுத்தல் இல்லாமல் அமைதியாக நிறுவல் நீக்கவும்:",
          "command": "cmstp /u /s \"{{சுயவிவரம்\\பாதை}}\"",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/windows/cmstp.md"
    },
