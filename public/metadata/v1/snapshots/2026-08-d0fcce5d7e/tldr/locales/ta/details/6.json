      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "தற்போதைய கோப்பகத்தில் ஒரு சரம் அல்லது வழக்கமான வெளிப்பாடு உள்ள கோப்புகளை மீண்டும் மீண்டும் தேடவும்:",
          "command": "ack \"{{தேடல்_முறை}}\"",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/ack.md#L9"
        },
        {
          "description": "கேஸ்-சென்சிட்டிவ் பேட்டர்னைத் தேடுங்கள்:",
          "command": "ack {{[-i|--ignore-case]}} \"{{தேடல்_முறை}}\"",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/ack.md#L13"
        },
        {
          "description": "ஒரு வடிவத்துடன் பொருந்தக்கூடிய வரிகளைத் தேடவும், [o]பொருந்திய உரையை மட்டும் அச்சிடவும் மற்றும் வரியின் மீதமுள்ளவை அல்ல:",
          "command": "ack {{[-o|--output '$&']}} \"{{தேடல்_முறை}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/ack.md#L17"
        },
        {
          "description": "ஒரு குறிப்பிட்ட வகை கோப்புகளுக்கான தேடலை வரம்பிடவும்:",
          "command": "ack {{[-t|--type]}} {{ruby}} \"{{தேடல்_முறை}}\"",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/ack.md#L21"
        },
        {
          "description": "ஒரு குறிப்பிட்ட வகை கோப்புகளில் தேட வேண்டாம்:",
          "command": "ack {{[-t|--type]}} no{{ruby}} \"{{தேடல்_முறை}}\"",
