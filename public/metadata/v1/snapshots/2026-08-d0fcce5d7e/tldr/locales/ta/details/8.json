          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/gem.md#L8"
        },
        {
          "description": "ரத்தினத்தின் சமீபத்திய பதிப்பை நிறுவவும்:",
          "command": "gem install {{ரத்தின_பெயர்}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/gem.md#L12"
        },
        {
          "description": "ஒரு ரத்தினத்தின் குறிப்பிட்ட பதிப்பை நிறுவவும்:",
          "command": "gem install {{ரத்தின_பெயர்}} {{[-v|--version]}} {{1.0.0}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/gem.md#L16"
        },
        {
          "description": "ஒரு ரத்தினத்தின் சமீபத்திய பொருந்தக்கூடிய (SemVer) பதிப்பை நிறுவவும்:",
          "command": "gem install {{ரத்தின_பெயர்}} {{[-v|--version]}} '~> {{1.0}}'",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/gem.md#L20"
