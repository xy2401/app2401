      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "நிறுவப்பட்ட அனைத்து நீட்டிப்புகளையும் பட்டியலிடுங்கள்:",
          "command": "gnome-extensions list",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/linux/gnome-extensions.md#L8"
        },
        {
          "description": "ஒரு குறிப்பிட்ட நீட்டிப்பு பற்றிய தகவலைக் காட்டு:",
          "command": "gnome-extensions info \"{{நீட்டிப்பு_ஐடி}}\"",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/linux/gnome-extensions.md#L12"
        },
