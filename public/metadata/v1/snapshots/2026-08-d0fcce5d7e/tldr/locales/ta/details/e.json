    {
      "id": "tldr--5e6925763f33",
      "canonicalPath": "common/sha1sum.md",
      "locale": "ta",
      "sourceLocale": "ta",
      "name": "sha1sum",
      "title": "sha1sum",
      "summary": "SHA1 மறையீட்டு சரிகாண்தொகையைக் கணி.",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "ஒன்று அல்லது அதற்கு மேற்பட்ட கோப்புகளுக்கான SHA1 சரிகாண்தொகையைக் கணி:",
          "command": "sha1sum {{கோப்பு1/பாதை கோப்பு2/பாதை ...}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/sha1sum.md#L8"
        },
        {
          "description": "SHA1 சரிகாண்தொகை பட்டியலைக் கணக்கிட்டு ஒரு கோப்பில் சேமிக்கவும்:",
          "command": "sha1sum {{கோப்பு1/பாதை கோப்பு2/பாதை ...}} > {{கோப்பு.sha1/பாதை}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/sha1sum.md#L12"
        },
        {
          "description": "`stdin` (இயல் உள்ளீடு) இலிருந்து SHA1 சரிகாண்தொகையை கணி:",
          "command": "{{கட்டளை}} | sha1sum",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/sha1sum.md#L16"
        },
        {
          "description": "SHA1 தொகைகள் மற்றும் கோப்புப்பெயர்களின் கோப்பைப் படித்து, எல்லாக் கோப்புகளிலும் சரிகாண்தொகைகள் பொருந்துகின்றன என்பதைச் சரிபார்க்கவும்:",
          "command": "sha1sum --check {{கோப்பு.sha1/பாதை}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/sha1sum.md#L20"
        },
        {
          "description": "விடுபட்ட கோப்புகள் அல்லது சரிபார்ப்பு தோல்வியுற்றால் மட்டுமே செய்தியைக் காட்டவும்:",
          "command": "sha1sum --check --quiet {{கோப்பு.sha1/பாதை}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/sha1sum.md#L24"
        },
        {
          "description": "சரிபார்ப்பு தோல்வியுற்றால், விடுபட்ட கோப்புகளைப் புறக்கணித்து, செய்தியை மட்டும் காட்டவும்:",
          "command": "sha1sum --ignore-missing --check --quiet {{கோப்பு.sha1/பாதை}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/sha1sum.md#L28"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ta/common/sha1sum.md"
    },
