      "examples": [
        {
          "description": "Отримати стандартний огляд ваших звичайних дисків:",
          "command": "dysk",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/linux/dysk.md#L8"
        },
        {
          "description": "Відсортувати за вільним розміром:",
          "command": "dysk {{[-s|--sort]}} free",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/linux/dysk.md#L12"
        },
        {
          "description": "Включити тільки HDD диски:",
          "command": "dysk {{[-f|--filter]}} 'disk = HDD'",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/linux/dysk.md#L16"
        },
        {
          "description": "Виключити SSD диски:",
          "command": "dysk {{[-f|--filter]}} 'disk <> SSD'",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/linux/dysk.md#L20"
        },
        {
          "description": "Відобразити диски з високим рівнем використання або низьким вільним простором:",
          "command": "dysk {{[-f|--filter]}} 'use > 65% | free < 50G'",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/linux/dysk.md#L24"
