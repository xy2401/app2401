    {
      "id": "tldr--c857247906a8",
      "canonicalPath": "common/7z.md",
      "locale": "uk",
      "sourceLocale": "uk",
      "name": "7z",
      "title": "7z",
      "summary": "Архіватор файлів з високим ступенем стиснення.",
      "platform": "cross-platform",
      "softwareIds": [
        "7zip--d4d4b542",
        "7zip-beta--fcb42f04",
        "7zip-dark--ba00fe33",
        "7zip-zstd--863a95a7",
        "nanazip--1fde7301",
        "nanazip-beta--5d7f53c7"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Додати ([a]dd) файл або каталог до нового або існуючого архіву:",
          "command": "7z a {{шлях/до/архіву.7z}} {{шлях/до/файлу_або_каталогу}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7z.md#L8"
        },
        {
          "description": "Зашифрувати існуючий архів (включаючи імена файлів):",
          "command": "7z a {{шлях/до/зашифрованого_архіву.7z}} -p{{пароль}} -mhe=on {{шлях/до/архіву.7z}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7z.md#L12"
        },
        {
          "description": "Розпакувати (e[x]tract) архів, зберігаючи оригінальну структуру каталогів:",
          "command": "7z x {{шлях/до/архіву.7z}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7z.md#L16"
        },
        {
          "description": "Розпакувати (e[x]tract) архів у певний каталог:",
          "command": "7z x {{шлях/до/архіву.7z}} -o{{шлях/до/каталогу}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7z.md#L20"
        },
        {
          "description": "Розпакувати (e[x]tract) архів у `stdout`:",
          "command": "7z x {{шлях/до/архіву.7z}} -so",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7z.md#L24"
        },
        {
          "description": "Архівувати ([a]rchive) за допомогою певного типу архіву:",
