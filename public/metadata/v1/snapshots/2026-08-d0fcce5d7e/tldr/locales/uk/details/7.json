      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Перевірити, чи запущений процес сервера adb, і запустити його:",
          "command": "adb start-server",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/adb.md#L9"
