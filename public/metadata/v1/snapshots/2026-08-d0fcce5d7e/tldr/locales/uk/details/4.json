    {
      "id": "tldr--9132652c7874",
      "canonicalPath": "common/zip.md",
      "locale": "uk",
      "sourceLocale": "uk",
      "name": "zip",
      "title": "zip",
      "summary": "Утиліта архівування файлів в Zip-архів. Дивіться також: `unzip`.",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "unxutils--5bef4004",
        "zip--cd5c7072",
        "zip--d51707ee",
        "zip-beta--fcfc22d8"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "Додати файли/каталоги до певного архіву рекурсивно ([r]ecursively):",
          "command": "zip {{[-r|--recurse-paths]}} {{шлях/до/архіву.zip}} {{шлях/до/файлу_або_каталогу1 шлях/до/файлу_або_каталогу2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/zip.md#L9"
        },
        {
          "description": "Видалити файли/каталоги із певного архіву ([d]elete):",
          "command": "zip {{[-d|--delete]}} {{шлях/до/архіву.zip}} {{шлях/до/файлу_або_каталогу1 шлях/до/файлу_або_каталогу2 ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/zip.md#L13"
        },
        {
          "description": "Архівувати файли/каталоги, окрім (e[x]cluding) зазначених:",
          "command": "zip {{[-r|--recurse-paths]}} {{шлях/до/архіву.zip}} {{шлях/до/файлу_або_каталогу1 шлях/до/файлу_або_каталогу2 ...}} {{[-x|--exclude]}} {{шлях/до/виключених_файлів_або_каталогів}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/zip.md#L17"
        },
        {
          "description": "Архівувати файли/каталоги з певним рівнем стиснення (`0` - найнижчий, `9` - найвищий):",
          "command": "zip {{[-r|--recurse-paths]}} -{{0..9}} {{шлях/до/архіву.zip}} {{шлях/до/файлу_або_каталогу1 шлях/до/файлу_або_каталогу2 ...}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/zip.md#L21"
        },
        {
          "description": "Створити зашифрований ([e]ncrypted) архів із певним паролем (з’явиться запит на введення пароля):",
          "command": "zip {{[-re|--recurse-paths --encrypt]}} {{шлях/до/архіву.zip}} {{шлях/до/файлу_або_каталогу1 шлях/до/файлу_або_каталогу2 ...}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/zip.md#L25"
        },
        {
          "description": "Архівувати файли/каталоги в архів з багатьох частин ([s]split) (наприклад, частини по 3 Гб):",
          "command": "zip {{[-rs|--recurse-paths --split-size]}} {{3g}} {{шлях/до/архіву.zip}} {{шлях/до/файлу_або_каталогу1 шлях/до/файлу_або_каталогу2 ...}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/zip.md#L29"
        },
        {
          "description": "Print a specific archive contents Вивести перелік вмісту певного архіву:",
