    {
      "id": "tldr--89f7e1fbff5c",
      "canonicalPath": "common/7za.md",
      "locale": "uk",
      "sourceLocale": "uk",
      "name": "7za",
      "title": "7za",
      "summary": "Архіватор файлів з високим ступенем стиснення. Подібний до `7z`, за винятком того, що він підтримує менше типів файлів, але є кросплатформним.",
      "platform": "cross-platform",
      "softwareIds": [
        "7zip-zstd--863a95a7"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Архівувати ([a]rchive) файл або каталог:",
          "command": "7za a {{шлях/до/архіву.7z}} {{шлях/до/файлу_або_каталогу}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L9"
        },
        {
          "description": "Зашифрувати існуючий архів (включаючи імена файлів):",
          "command": "7za a {{шлях/до/зашифрованого_архіву.7z}} -p{{пароль}} -mhe={{on}} {{шлях/до/архіву.7z}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L13"
        },
        {
          "description": "Розпакувати (e[x]tract) архів, зберігаючи оригінальну структуру каталогів:",
          "command": "7za x {{шлях/до/архіву.7z}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L17"
        },
        {
          "description": "Розпакувати (e[x]tract) архів у певний каталог:",
          "command": "7za x {{шлях/до/архіву.7z}} -o{{шлях/до/каталогу}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L21"
        },
        {
          "description": "Розпакувати (e[x]tract) архів у `stdout`:",
          "command": "7za x {{шлях/до/архіву.7z}} -so",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L25"
        },
        {
          "description": "Архівувати ([a]rchive) за допомогою певного типу архіву:",
          "command": "7za a -t{{7z|bzip2|gzip|lzip|tar|...}} {{шлях/до/архіву.7z}} {{шлях/до/файлу_або_каталогу}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L29"
        },
        {
          "description": "Вивести ([l]ist) перелік вмісту архіву:",
          "command": "7za l {{шлях/до/архіву.7z}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L33"
        },
        {
          "description": "Встановити рівень стиснення (вище означає більше стиснення, але повільніше):",
          "command": "7za a {{шлях/до/архіву.7z}} -mx={{0|1|3|5|7|9}} {{шлях/до/файлу_або_каталогу}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.uk/common/7za.md"
    },
