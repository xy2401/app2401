      "id": "tldr--6f84dee948da",
      "canonicalPath": "common/rm.md",
      "locale": "cs",
      "sourceLocale": "cs",
      "name": "rm",
      "title": "rm",
      "summary": "Maže soubory nebo adresáře. Viz také: `rmdir`, `trash`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Smazat konkrétní soubory:",
          "command": "rm {{cesta/k/souboru1 cesta/k/souboru2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/rm.md#L9"
        },
        {
          "description": "Smazat konkrétní soubory ignorující neexistující:",
          "command": "rm {{[-f|--force]}} {{cesta/k/souboru1 cesta/k/souboru2 ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/rm.md#L13"
        },
        {
          "description": "Smazat konkrétní soubory dotazující se interaktivně před každým smazáním:",
          "command": "rm {{[-i|--interactive]}} {{cesta/k/souboru1 cesta/k/souboru2 ...}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/rm.md#L17"
        },
        {
          "description": "Smazat konkrétní soubory vypisující informace o každém smazáním:",
          "command": "rm {{[-v|--verbose]}} {{cesta/k/souboru1 cesta/k/souboru2 ...}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/rm.md#L21"
        },
        {
          "description": "Smazat konkrétní soubory a adresáře rekurzivně:",
          "command": "rm {{[-r|--recursive]}} {{cesta/k/souboru_nebo_adresari1 cesta/k/souboru_nebo_adresari2 ...}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/rm.md#L25"
        },
        {
          "description": "Smazat prázdné adresáře (tohle je považováno za bezpečnou metodu):",
          "command": "rm {{[-d|--dir]}} {{cesta/k/adresari}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/rm.md#L29"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/rm.md"
