      ],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "Vypíše obsah souboru do `stdout`:",
          "command": "cat {{cesta/k/souboru}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cat.md#L8"
        },
        {
          "description": "Spojí několik souborů do výstupního souboru:",
          "command": "cat {{cesta/k/souboru1 cesta/k/souboru2 ...}} > {{cesta/k/vystupnimu_souboru}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cat.md#L12"
