        {
          "description": "Přidá několik souborů do výstupního souboru:",
          "command": "cat {{cesta/k/souboru1 cesta/k/souboru2 ...}} >> {{cesta/k/vystupnimu_souboru}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cat.md#L16"
        },
        {
          "description": "Zkopíruje obsah souboru do výstupního souboru bez vyrovnávací paměti:",
          "command": "cat -u {{/dev/tty12}} > {{/dev/tty13}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cat.md#L20"
        },
        {
          "description": "Vypíše `stdin` do souboru:",
          "command": "cat - > {{cesta/k/souboru}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cat.md#L24"
