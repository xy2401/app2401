    {
      "id": "tldr--0db6813af711",
      "canonicalPath": "linux/top.md",
      "locale": "cs",
      "sourceLocale": "cs",
      "name": "top",
      "title": "top",
      "summary": "Zobrazuje dynamické informace o běžících procesech v reálném čase. Viz také: `htop`, `atop`, `glances`, `btop`, `btm`.",
      "platform": "linux",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "Zapnout `top`:",
          "command": "top",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md#L9"
        },
        {
          "description": "Nezobrazovat nečinné nebo zombie procesy:",
          "command": "top {{[-i|--idle-toggle]}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md#L13"
        },
        {
          "description": "Zobrazovat pouze procesy vlastněné daným uživatelem:",
          "command": "top {{[-u|--filter-only-euser]}} {{jmeno_uzivatele}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md#L17"
        },
        {
          "description": "Řadit procesy podle pole:",
          "command": "top {{[-o|--sort-override]}} {{nazev_pole}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md#L21"
        },
        {
          "description": "Zobrazovat individuální vlákna daného procesu:",
          "command": "top {{[-Hp|--threads-show --pid]}} {{id_procesu}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md#L25"
        },
        {
          "description": "Zobrazovat pouze procesy s daným(i) PID, předaný jako list rozdělený čárkou. (Normálně byste nevěděli PID z hlavy. Tento příklad vybíra PIDs podle názvu procesu):",
          "command": "top {{[-p|--pid]}} $(pgrep {{[-d|--delimiter]}} ',' {{nazev_procesu}})",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md#L29"
        },
        {
          "description": "Zobrazit nápovědu o interaktivních příkazech:",
          "command": "<?>",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md#L33"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/linux/top.md"
    },
