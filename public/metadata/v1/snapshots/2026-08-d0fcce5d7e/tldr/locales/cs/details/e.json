    {
      "id": "tldr--c2fe16eaac9d",
      "canonicalPath": "common/cp.md",
      "locale": "cs",
      "sourceLocale": "cs",
      "name": "cp",
      "title": "cp",
      "summary": "Kopíruje soubory a adresáře.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Zkopírovat soubor do jiné lokace:",
          "command": "cp {{cesta/ke/zdrojovemu_souboru.ext}} {{cesta/k/cilovemu_souboru.ext}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L8"
        },
        {
          "description": "Zkopírovat soubor do jiného adresáře, zachová název souboru:",
          "command": "cp {{cesta/ke/zdrojovemu_adresari.ext}} {{cesta/k/nadrazenemu_adresari}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L12"
        },
        {
          "description": "Rekurzivně zkopírovat obsah adresáře do jiné lokace (pokud cíl existuje, adresář se zkopíruje do něj):",
          "command": "cp {{[-r|--recursive]}} {{cesta/ke/zdrojovemu_adresari}} {{cesta/k/cilovemu_adresare}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L16"
        },
        {
          "description": "Zkopírovat adresář rekurzivně, ve verbózním režimu (zobrazí soubory jak jsou zkopírovány):",
          "command": "cp {{[-vr|--verbose --recursive]}} {{cesta/ke/zdrojovemu_adresari}} {{cesta/k/cilovemu_adresari}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L20"
        },
        {
          "description": "Zkopírovat více souborů do adresáře naráz:",
          "command": "cp {{[-t|--target-directory]}} {{cesta/k/cilovemu_adresari}} {{cesta/k/souboru1 cesta/k/souboru2 ...}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L24"
        },
        {
          "description": "Zkopírovat všechny soubory se specifickou koncovkou do jiné lokace, v interaktívním režimu (zeptá se uživatele před přepsáním):",
          "command": "cp {{[-i|--interactive]}} {{*.ext}} {{cesta/k/cilovemu_adresari}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L28"
        },
        {
          "description": "Následovat symbolické linky před zkopírováním:",
          "command": "cp {{[-L|--dereference]}} {{link}} {{cesta/k/cilovemu_adresari}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L32"
        },
        {
          "description": "Používat plnou cestu zdrojových souborů, automaticky vytvoří jakékoliv chybějící meziadresáře při kopírováním:",
          "command": "cp --parents {{zdrojova/cesta/k/souboru}} {{cesta/k/cilovemu_souboru}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/cp.md"
    },
    {
      "id": "tldr--c857247906a8",
      "canonicalPath": "common/7z.md",
      "locale": "cs",
      "sourceLocale": "cs",
      "name": "7z",
      "title": "7z",
      "summary": "Archivátor souborů s vysokým poměrem komprese.",
      "platform": "cross-platform",
      "softwareIds": [
        "7zip--d4d4b542",
        "7zip-beta--fcb42f04",
        "7zip-dark--ba00fe33",
        "7zip-zstd--863a95a7",
        "nanazip--1fde7301",
        "nanazip-beta--5d7f53c7"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Přidat soubor nebo adresář do nového nebo existujícího archivu:",
          "command": "7z a {{cesta/k/archivu.7z}} {{cesta/k/souboru_nebo_adresari}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L8"
        },
        {
          "description": "Zašifrovat existující archiv (včetně názvů souborů):",
          "command": "7z a {{cesta/k/zasifrovanemu.7z}} -p{{heslo}} -mhe=on {{cesta/k/archivu.7z}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L12"
        },
        {
          "description": "E[x]trahovat archiv se zachováním originální struktury adresáře:",
          "command": "7z x {{cesta/k/archivu.7z}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L16"
        },
        {
          "description": "E[x]trahovat archiv do konkrétního adresáře:",
          "command": "7z x {{cesta/k/archivu.7z}} -o{{cesta/k/vystupu}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L20"
        },
        {
          "description": "E[x]trahovat archiv do `stdout`:",
          "command": "7z x {{cesta/k/archivu.7z}} -so",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L24"
        },
        {
          "description": "[a]rchivovat na specifický typ archivu:",
          "command": "7z a -t{{7z|bzip2|gzip|lzip|tar|zip}} {{cesta/k/archivu}} {{cesta/k/souboru_nebo_adresari}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L28"
        },
        {
          "description": "Vypsat obsah archivu:",
          "command": "7z l {{cesta/k/archivu.7z}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L32"
        },
        {
          "description": "Nastavit stupeň komprese (vyšší znamená větší komprese, ale pomalejší):",
          "command": "7z a {{cesta/k/archivu.7z}} -mx={{0|1|3|5|7|9}} {{cesta/k/souboru_nebo_adresari}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/7z.md"
    },
