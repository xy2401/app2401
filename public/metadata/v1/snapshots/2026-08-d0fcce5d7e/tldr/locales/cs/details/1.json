      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "Extrahovat všechny soubory/adresáře ze specifického archivu do aktuálního adresáře:",
          "command": "unzip {{cesta/k/archivu1.zip cesta/k/archivu2.zip ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/unzip.md#L9"
