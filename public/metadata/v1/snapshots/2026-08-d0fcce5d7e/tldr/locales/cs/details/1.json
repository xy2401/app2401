        {
          "description": "Extrahovat soubory/adresáře z archivu do konkrétní cesty:",
          "command": "unzip {{cesta/k/archivu1.zip cesta/k/archivu2.zip ...}} -d {{cesta/k/vystupu}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/unzip.md#L13"
