    {
      "id": "tldr--c25a4cec12c4",
      "canonicalPath": "common/gzip.md",
      "locale": "cs",
      "sourceLocale": "cs",
      "name": "gzip",
      "title": "gzip",
      "summary": "Komprimuje/dekomprimuje soubory s `gzip` kompresí (LZ77).",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "gzip--1bc6b0b1",
        "gzip--dc3edbf3",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "Komprimovat soubor a nahradit jej `gzip` archivem:",
          "command": "gzip {{cesta/k/souboru}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md#L8"
        },
        {
          "description": "Dekomprimovat souboru a nahradit jej původní nekomprimovanou verzí:",
          "command": "gzip {{[-d|--decompress]}} {{cesta/k/souboru.gz}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md#L12"
        },
        {
          "description": "Komprimovat soubor se zachováním původního souboru:",
          "command": "gzip {{[-k|--keep]}} {{cesta/k/souboru}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md#L16"
        },
        {
          "description": "Komprimovat soubor a zadat název výstupního souboru:",
          "command": "gzip {{[-c|--stdout]}} {{cesta/k/souboru}} > {{souboru/k/komprimovanemu_souboru.gz}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md#L20"
        },
        {
          "description": "Dekomprimovat `gzip` archiv a zadat název výstupního souboru:",
          "command": "gzip {{[-c|--stdout]}} {{[-d|--decompress]}} {{cesta/k/souboru.gz}} > {{cesta/k/nekomprimovanemu_souboru}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md#L24"
        },
        {
          "description": "Upřesnit úroveň komprese. 1 je nejrychlejší (nízká komprese), 9 je nejpomalejší (vysoká komprese), 6 je výchozí:",
          "command": "gzip -{{1..9}} {{[-c|--stdout]}} {{cesta/k/souboru}} > {{cesta/ke/komprimovanemu_souboru.gz}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md#L28"
        },
        {
          "description": "Zobrazit název a procento zmenšení pro každý komprimovaný nebo dekomprimovaný soubor:",
          "command": "gzip {{[-v|--verbose]}} {{[-d|--decompress]}} {{cesta/k/souboru.gz}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md#L32"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.cs/common/gzip.md"
    },
