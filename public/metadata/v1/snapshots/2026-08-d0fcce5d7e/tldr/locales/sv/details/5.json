      "id": "tldr--6f84dee948da",
      "canonicalPath": "common/rm.md",
      "locale": "sv",
      "sourceLocale": "sv",
      "name": "rm",
      "title": "rm",
      "summary": "Ta bort filer eller mappar. Se även: `rmdir`, `trash`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 4,
      "examples": [
        {
          "description": "Ta bort filer från godtyckliga ställen:",
          "command": "rm {{sökväg/till/fil1 sökväg/till/en/annan/fil2 ...}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/rm.md#L9"
        },
        {
          "description": "Interaktivt ta bort flera filer, genom att fråga om borttagning för varje fil:",
          "command": "rm -i {{fil(er)}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/rm.md#L13"
        },
        {
          "description": "Ta bort filer och visa ett meddelande för varje borttagning:",
          "command": "rm -v {{sökväg/till/mapp/*}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/rm.md#L17"
        },
        {
          "description": "Rekursivt ta bort en mapp och dess undermappar:",
          "command": "rm -r {{sökväg/till/mapp}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/rm.md#L21"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/rm.md"
