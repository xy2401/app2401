    {
      "id": "tldr--122367070ea8",
      "canonicalPath": "common/tail.md",
      "locale": "sv",
      "sourceLocale": "sv",
      "name": "tail",
      "title": "tail",
      "summary": "Via den sista delen av en fil. Se även: `head`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "rktools2k3--c5a81681",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Visa de sista 10 raderna av en fil:",
          "command": "tail {{sökväg/till/fil}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L9"
        },
        {
          "description": "Visa de 10 sista raderna av flera olika filer:",
          "command": "tail {{sökväg/till/fil1 sökväg/till/fil2 ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L13"
        },
        {
          "description": "Visa de sista 5 raderna av en fil:",
          "command": "tail {{[-5|--lines 5]}} {{sökväg/till/fil}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L17"
        },
        {
          "description": "Visa de sista `antal` raderna av en fil:",
          "command": "tail {{[-n|--lines]}} +{{antal}} {{sökväg/till/fil}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L21"
        },
        {
          "description": "Visa de sista `antal` bytes av en fil:",
          "command": "tail {{[-c|--bytes]}} {{antal}} {{sökväg/till/fil}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L25"
        },
        {
          "description": "Visa de sista raderna av en fil och fortsätt läsa till `<Ctrl c>`:",
          "command": "tail {{[-f|--follow]}} {{sökväg/till/fil}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L29"
        },
        {
          "description": "Fortsätt läsa filen till `<Ctrl c>`, även om filen blir oåtkomlig:",
          "command": "tail {{[-F|--retry --follow]}} {{sökväg/till/fil}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L33"
        },
        {
          "description": "Visa de sista `antal` raderna i en fil och updatera varje `sekunder` sekunder:",
          "command": "tail {{[-n|--lines]}} {{antal}} {{[-s|--sleep-interval]}} {{sekunder}} {{[-f|--follow]}} {{sökväg/till/fil}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/common/tail.md"
    },
