      "name": "gpupdate",
      "title": "gpupdate",
      "summary": "Ett verktyg för att kontrollera och uppdatera Windows Group Policy settings.",
      "platform": "windows",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 4,
      "examples": [
        {
          "description": "Kontrollera och tillämpa uppdaterade Group Policy settings:",
          "command": "gpupdate",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/windows/gpupdate.md#L8"
        },
        {
          "description": "Ange för vilka Group Policy inställningar du vill kontrollera för uppdateringar:",
          "command": "gpupdate /target:{{datornamn|användare}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/windows/gpupdate.md#L12"
        },
        {
          "description": "Tvinga alla Group Policy inställningar att tillämpas igen:",
          "command": "gpupdate /force",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/windows/gpupdate.md#L16"
        },
        {
          "description": "Visa detaljerad användningsinformation:",
          "command": "gpupdate /?",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/windows/gpupdate.md#L20"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.sv/windows/gpupdate.md"
