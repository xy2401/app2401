    {
      "id": "tldr--079015c65387",
      "canonicalPath": "windows/doskey.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "doskey",
      "title": "doskey",
      "summary": "ম্যাক্রোজ, উইন্ডোজ কমান্ড এবং কমান্ড-লাইন পরিচালনা করুন।",
      "platform": "windows",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "উপস্থিত ম্যাক্রোগুলির তালিকা তৈরি করুন:",
          "command": "doskey /macros",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md#L8"
        },
        {
          "description": "একটি নতুন ম্যাক্রো তৈরি করুন:",
          "command": "doskey {{নাম}} = \"{{কমান্ড}}\"",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md#L12"
        },
        {
          "description": "একটি নির্দিষ্ট সম্পাদনযোগ্য জন্য একটি নতুন ম্যাক্রো তৈরি করুন:",
          "command": "doskey /exename={{সম্পাদন}} {{নাম}} = \"{{কমান্ড}}\"",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md#L16"
        },
        {
          "description": "ম্যাক্রো অপসারণ করুন:",
          "command": "doskey {{নাম}} =",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md#L20"
        },
        {
          "description": "মেমোরিতে সংরক্ষিত সমস্ত কমান্ড দেখান:",
          "command": "doskey /history",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md#L24"
        },
        {
          "description": "পোর্টেবিলিটির জন্য ম্যাক্রোগুলি ফাইলে সংরক্ষণ করুন:",
          "command": "doskey /macros > {{ফাইলের\\পথ}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md#L28"
        },
        {
          "description": "একটি ফাইল থেকে ম্যাক্রোগুলি লোড করুন:",
          "command": "doskey /macrofile = {{ফাইলের\\পথ}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md#L32"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/windows/doskey.md"
    },
