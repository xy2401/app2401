      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 3,
      "examples": [
        {
          "description": "এক বা একাধিক প্রোফাইল ফাইল ডিফল্ট প্রোফাইল ডিরেক্টরিতে মার্জ করুন:",
          "command": "sudo aa-mergeprof {{ফাইল১ ফাইল২ ...}}",
