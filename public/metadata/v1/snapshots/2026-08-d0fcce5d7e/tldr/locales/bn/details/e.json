      "id": "tldr--a583dc9da284",
      "canonicalPath": "common/autojump.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "autojump",
      "title": "autojump",
      "summary": "আপনি সবচেয়ে বেশি পরিদর্শন করেন এমন ডিরেক্টরিগুলোর মধ্যে দ্রুত জাম্প করুন। আরও কম টাইপিংয়ের জন্য `j` বা `jc`-এর মতো উপনাম (aliases) প্রদান করা হয়েছে। আরও দেখুন: `bashmarks`।",
      "platform": "cross-platform",
      "softwareIds": [
        "autojump--0df1f83d",
        "autojump--e473ea98"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "আপনার শেলে `autojump` উপনামগুলো যোগ করুন:",
          "command": "source /usr/share/autojump/autojump.{{bash|fish|zsh}}",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/autojump.md#L10"
        },
        {
          "description": "প্রদত্ত প্যাটার্ন রয়েছে এমন কোনো ডিরেক্টরিতে জাম্প করুন:",
          "command": "j {{প্যাটার্ন}}",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/autojump.md#L14"
        },
        {
          "description": "বর্তমান ডিরেক্টরির সাব-ডিরেক্টরিতে (চাইল্ড) জাম্প করুন যেটিতে প্রদত্ত প্যাটার্ন রয়েছে:",
          "command": "jc {{প্যাটার্ন}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/autojump.md#L18"
