    {
      "id": "tldr--165c2c8fcac1",
      "canonicalPath": "common/acme.sh.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "acme.sh",
      "title": "acme.sh",
      "summary": "এটি একটি শেল স্ক্রিপ্ট, যা ACME ক্লায়েন্ট প্রোটোকল বাস্তবায়ন করে, এটি `certbot`-এর একটি বিকল্প। আরও দেখুন: `acme.sh dns`।",
      "platform": "cross-platform",
      "softwareIds": [
        "acme-sh--cd6f6523"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "webroot মোড ব্যবহার করে একটি সার্টিফিকেট ইস্যু করুন:",
          "command": "acme.sh --issue {{[-d|--domain]}} {{example.com}} {{[-w|--webroot]}} /{{webroot/এর/পাথ}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md#L9"
        },
        {
          "description": "পোর্ট ৮০ ব্যবহার করে standalone মোডে একাধিক ডোমেইনের জন্য একটি সার্টিফিকেট ইস্যু করুন:",
          "command": "acme.sh --issue --standalone {{[-d|--domain]}} {{example.com}} {{[-d|--domain]}} {{www.example.com}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md#L13"
        },
        {
          "description": "পোর্ট ৪৪৩ ব্যবহার করে standalone TLS মোডে একটি সার্টিফিকেট ইস্যু করুন:",
          "command": "acme.sh --issue --alpn {{[-d|--domain]}} {{example.com}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md#L17"
        },
        {
          "description": "কার্যকর (working) `nginx` কনফিগারেশন ব্যবহার করে একটি সার্টিফিকেট ইস্যু করুন:",
          "command": "acme.sh --issue --nginx {{[-d|--domain]}} {{example.com}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md#L21"
        },
        {
          "description": "কার্যকর (working) Apache কনফিগারেশন ব্যবহার করে একটি সার্টিফিকেট ইস্যু করুন:",
          "command": "acme.sh --issue --apache {{[-d|--domain]}} {{example.com}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md#L25"
        },
        {
          "description": "স্বয়ংক্রিয় DNS API মোড ব্যবহার করে একটি ওয়াইল্ডকার্ড (`*`) সার্টিফিকেট ইস্যু করুন:",
          "command": "acme.sh --issue --dns {{dns_cf}} {{[-d|--domain]}} {{*.example.com}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md#L29"
        },
        {
          "description": "নির্দিষ্ট লোকেশনে সার্টিফিকেট ফাইল ইনস্টল করুন (স্বয়ংক্রিয় সার্টিফিকেট নবায়নের জন্য উপকারী):",
          "command": "acme.sh {{[-i|--install-cert]}} {{[-d|--domain]}} {{example.com}} --key-file /{{example.com.key/এর/পাথ}} --fullchain-file /{{example.com.cer/এর/পাথ}} --reloadcmd \"{{systemctl force-reload nginx}}\"",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md#L33"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/acme.sh.md"
    },
