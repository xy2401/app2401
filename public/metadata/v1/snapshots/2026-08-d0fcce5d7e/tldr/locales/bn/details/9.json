      "id": "tldr--23b1aa76ee00",
      "canonicalPath": "common/clang++.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "clang++",
      "title": "clang++",
      "summary": "C++ সোর্স ফাইল কম্পাইল করে। LLVM-এর অংশ।",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "একটি সেট সোর্স কোড ফাইল একটি এক্সিকিউটেবল বাইনারিতে কম্পাইল করুন:",
          "command": "clang++ {{সোর্স১/এর/পাথ.cpp সোর্স২/এর/পাথ.cpp ...}} {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল/এর/পাথ}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L9"
        },
        {
          "description": "সকল ত্রুটি ও সতর্কবার্তার আউটপুট সক্রিয় করুন:",
          "command": "clang++ {{সোর্স/এর/পাথ.cpp}} -Wall {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L13"
        },
        {
          "description": "সাধারণ সতর্কবার্তা দেখুন, আউটপুটে ডিবাগ চিহ্ন যোগ করুন এবং ডিবাগিং প্রভাবিত না করে অপ্টিমাইজ করুন:",
          "command": "clang++ {{সোর্স/এর/পাথ.cpp}} -Wall {{[-g|--debug]}} -Og {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল/এর/পাথ}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L17"
        },
        {
          "description": "কম্পাইল করার জন্য একটি ল্যাঙ্গুয়েজ স্ট্যান্ডার্ড নির্বাচন করুন:",
          "command": "clang++ {{সোর্স/এর/পাথ.cpp}} -std={{c++20}} {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল/এর/পাথ}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L21"
        },
        {
          "description": "সোর্স ফাইলের চেয়ে ভিন্ন পাথে থাকা, লাইব্রেরি অন্তর্ভুক্ত করুন:",
          "command": "clang++ {{সোর্স/এর/পাথ.cpp}} {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল/এর/পাথ}} -I{{হেডার_পাথ/এর/পাথ}} -L{{লাইব্রেরি_পাথ/এর/পাথ}} -l{{লাইব্রেরি_নাম/এর/পাথ}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L25"
        },
        {
          "description": "সোর্স কোড LLVM Intermediate Representation (IR)-এ কম্পাইল করুন:",
          "command": "clang++ {{[-S|--assemble]}} -emit-llvm {{সোর্স/এর/পাথ.cpp}} {{[-o|--output]}} {{আউটপুট/এর/পাথ.ll}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L29"
        },
        {
          "description": "পারফরম্যান্সের জন্য কম্পাইলকৃত প্রোগ্রাম অপ্টিমাইজ করুন:",
          "command": "clang++ {{সোর্স/এর/পাথ.cpp}} -O{{1|2|3|fast}} {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল/এর/পাথ}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L33"
        },
        {
          "description": "সংস্করণ (version) প্রদর্শন করুন:",
          "command": "clang++ --version",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang%2B%2B.md#L37"
        }
