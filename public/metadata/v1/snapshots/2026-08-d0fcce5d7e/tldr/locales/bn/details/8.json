      "id": "tldr--16e31a4415f5",
      "canonicalPath": "common/getuserspns.py.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "GetUserSPNs.py",
      "title": "GetUserSPNs.py",
      "summary": "Active Directory ব্যবহারকারীর অ্যাকাউন্টের সাথে সম্পর্কিত Service Principal Names (SPNs) পুনরুদ্ধার করুন। Impacket স্যুইটের অংশ।",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "একটি SPN সহ ব্যবহারকারী অ্যাকাউন্ট তালিকাভুক্ত করুন এবং তাদের Kerberos TGS টিকিট অনুরোধ করুন:",
          "command": "GetUserSPNs.py {{ডোমেইন}}/{{ইউজারনেম}}:{{পাসওয়ার্ড}} -dc-ip {{ডোমেইন_কন্ট্রোলার_আইপি}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/getuserspns.py.md#L9"
        },
        {
          "description": "pass-the-hash অথেন্টিকেশন ব্যবহার করুন:",
          "command": "GetUserSPNs.py {{ডোমেইন}}/{{ইউজারনেম}} -hashes {{LM_হ্যাশ}}:{{NT_হ্যাশ}} -dc-ip {{ডোমেইন_কন্ট্রোলার_আইপি}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/getuserspns.py.md#L13"
        },
        {
          "description": "আউটপুট একটি ফাইলে সংরক্ষণ করুন:",
          "command": "GetUserSPNs.py {{ডোমেইন}}/{{ইউজারনেম}}:{{পাসওয়ার্ড}} -dc-ip {{ডোমেইন_কন্ট্রোলার_আইপি}} -outputfile {{আউটপুট_ফাইল/এর/পাথ}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/getuserspns.py.md#L17"
        },
        {
          "description": "শুধুমাত্র TGS টিকিট অনুরোধ করুন:",
          "command": "GetUserSPNs.py {{ডোমেইন}}/{{ইউজারনেম}}:{{পাসওয়ার্ড}} -dc-ip {{ডোমেইন_কন্ট্রোলার_আইপি}} -request",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/getuserspns.py.md#L21"
