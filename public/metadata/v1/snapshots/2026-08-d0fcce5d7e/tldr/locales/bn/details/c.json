      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 5,
      "examples": [
        {
          "description": "বর্তমান সোর্সে কোনো প্যাকেজ খোঁজার জন্য:",
          "command": "apt-cache search {{কোয়েরি}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/linux/apt-cache.md#L8"
