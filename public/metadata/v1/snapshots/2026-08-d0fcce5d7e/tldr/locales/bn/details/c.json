      "id": "tldr--49f90f66b618",
      "canonicalPath": "common/clang.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "clang",
      "title": "clang",
      "summary": "C, C++ এবং Objective-C এর সোর্স ফাইল কম্পাইল করে। GCC-এর বিকল্প হিসেবে ব্যবহৃত হয়ে থাকে। LLVM-এর অংশ।",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "একাধিক সোর্স ফাইল একটি এক্সিকিউটেবলে কম্পাইল করুন:",
          "command": "clang {{সোর্স১/এর/পাথ.c সোর্স২/এর/পাথ.c ...}} {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল/এর/পাথ}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang.md#L9"
        },
        {
          "description": "সকল ত্রুটি ও সতর্কবার্তার আউটপুট এক্টিভেইট করুন:",
          "command": "clang {{সোর্স/এর/পাথ.c}} -Wall {{[-o|--output]}} {{আউটপুট_এক্সিকিউটেবল}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/clang.md#L13"
        },
