      "canonicalPath": "common/hx.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "hx",
      "title": "hx",
      "summary": "Helix, একটি পোস্ট-মডার্ন টেক্সট এডিটর, বিভিন্ন ধরনের টেক্সট ম্যানিপুলেশনের জন্য বিভিন্ন মোড প্রদান করে। `<i>` চাপলে insert মোড চালু হয়। `<Esc>` চাপলে normal মোডে প্রবেশ করে, যা Helix কমান্ড ব্যবহার সক্ষম করে।",
      "platform": "cross-platform",
      "softwareIds": [
        "helix--d8920c71"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "একটি ফাইল খুলুন:",
          "command": "hx {{ফাইল/এর/পাথ}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/hx.md#L9"
        },
        {
          "description": "ফাইল খুলুন এবং একে অপরের পাশে দেখান:",
          "command": "hx --vsplit {{ফাইল১/এর/পাথ ফাইল২/এর/পাথ ...}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/hx.md#L13"
        },
