    {
      "id": "tldr--21ba38eeddf8",
      "canonicalPath": "common/2to3.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "2to3",
      "title": "2to3",
      "summary": "Python 2-এর কোডকে স্বয়ংক্রিয়ভাবে Python 3–এ রূপান্তর করার জন্য ব্যবহৃত হয়। এই মডিউলটি Python 3.11 থেকে ডিপ্রিকেটেড এবং Python 3.13 থেকে সম্পূর্ণভাবে রিমুভ করা হয়েছে।",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "ফাইলে কোনো পরিবর্তন না করে, যেসব পরিবর্তন করা হবে সেগুলো দেখান (dry-run):",
          "command": "2to3 {{ফাইল.py/এর/পাথ}}",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md#L10"
        },
        {
          "description": "একটি Python 2 ফাইলকে Python 3–এ রূপান্তর করুন:",
          "command": "2to3 {{[-w|--write]}} {{ফাইল.py/এর/পাথ}}",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md#L14"
        },
        {
          "description": "নির্দিষ্ট Python 2 ভাষাগত ফিচারগুলোকে Python 3–এ রূপান্তর করুন:",
          "command": "2to3 {{[-w|--write]}} {{ফাইল.py/এর/পাথ}} {{[-f|--fix]}} {{raw_input}} {{[-f|--fix]}} {{প্রিন্ট}}",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md#L18"
        },
        {
          "description": "নির্দিষ্ট করা ফিচারগুলো বাদ দিয়ে বাকি সব Python 2 ভাষাগত ফিচারকে Python 3–এ রূপান্তর করুন:",
          "command": "2to3 {{[-w|--write]}} {{ফাইল.py/এর/পাথ}} {{[-x|--nofix]}} {{has_key}} {{[-x|--nofix]}} {{isinstance}}",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md#L22"
        },
        {
          "description": "Python 2 থেকে Python 3–এ রূপান্তরযোগ্য সব এভেলেভেল ভাষাগত ফিচারের তালিকা দেখান:",
          "command": "2to3 {{[-l|--list-fixes]}}",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md#L26"
        },
        {
          "description": "একটি ডিরেক্টরির সব Python 2 ফাইলকে Python 3–এ রূপান্তর করুন:",
          "command": "2to3 {{[-o|--output-dir]}} {{python3_ডিরেক্টরি/এর/পাথ}} {{[-W|--write-unchanged-files]}} {{[-n|--nobackups]}} {{python2_ডিরেক্টরি/এর/পাথ}}",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md#L30"
        },
        {
          "description": "একাধিক থ্রেড ব্যবহার করে 2to3 চালান:",
          "command": "2to3 {{[-j|--processes]}} {{4}} {{[-o|--output-dir]}} {{python3_ডিরেক্টরি/এর/পাথ}} {{[-w|--write]}} {{[-n|--nobackups]}} --no-diffs {{python2_ডিরেক্টরি/এর/পাথ}}",
          "line": 34,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md#L34"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/2to3.md"
    },
