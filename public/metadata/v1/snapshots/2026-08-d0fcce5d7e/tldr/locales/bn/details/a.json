    {
      "id": "tldr--118a4721015a",
      "canonicalPath": "common/bzgrep.md",
      "locale": "bn",
      "sourceLocale": "bn",
      "name": "bzgrep",
      "title": "bzgrep",
      "summary": "`grep` ব্যবহার করে `bzip2` কম্প্রেসড ফাইলে প্যাটার্ন খুঁজুন।",
      "platform": "cross-platform",
      "softwareIds": [],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "একটি কম্প্রেসড ফাইলের মধ্যে একটি প্যাটার্ন অনুসন্ধান করুন:",
          "command": "bzgrep \"{{সার্চ_প্যাটার্ন}}\" {{ফাইল/এর/পাথ}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md#L8"
        },
        {
          "description": "একটি bzip2 কম্প্রেসড `.tar` আর্কাইভে রিকার্সিভভাবে ফাইলে একটি প্যাটার্ন অনুসন্ধান করুন:",
          "command": "bzgrep {{[-r|--recursive]}} \"{{সার্চ_প্যাটার্ন}}\" {{tar_ফাইল/এর/পাথ}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md#L12"
        },
        {
          "description": "প্রতিটি ম্যাচের আশেপাশে, আগে বা পরে 3 লাইনের [C]ontext প্রিন্ট করুন:",
          "command": "bzgrep {{--context|--before-context|--after-context}} 3 \"{{সার্চ_প্যাটার্ন}}\" {{ফাইল/এর/পাথ}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md#L16"
        },
        {
          "description": "প্রতিটি ম্যাচের জন্য ফাইলের নাম এবং লাইন নম্বর প্রিন্ট করুন:",
          "command": "bzgrep {{[-H|--with-filename]}} {{[-n|--line-number]}} \"{{সার্চ_প্যাটার্ন}}\" {{ফাইল/এর/পাথ}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md#L20"
        },
        {
          "description": "একটি প্যাটার্নের সাথে মিলে যাওয়া লাইন অনুসন্ধান করুন, শুধুমাত্র মিলে যাওয়া টেক্সট প্রিন্ট করুন:",
          "command": "bzgrep {{[-o|--only-matching]}} \"{{সার্চ_প্যাটার্ন}}\" {{ফাইল/এর/পাথ}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md#L24"
        },
        {
          "description": "`stdin`-এ এমন লাইন অনুসন্ধান করুন যা প্যাটার্নের সাথে মেলে না:",
          "command": "cat {{bz_কম্প্রেসড_ফাইল/এর/পাথ}} | bzgrep {{[-v|--invert-match]}} \"{{সার্চ_প্যাটার্ন}}\"",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md#L28"
        },
        {
          "description": "এক্সটেন্ডেড `regex` ব্যবহার করুন (`?`, `+`, `{}`, `()`, এবং `|` সাপোর্ট করে), case-insensitive মোডে:",
          "command": "bzgrep {{[-E|--extended-regexp]}} {{[-i|--ignore-case]}} \"{{সার্চ_প্যাটার্ন}}\" {{ফাইল/এর/পাথ}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md#L32"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/bzgrep.md"
    },
