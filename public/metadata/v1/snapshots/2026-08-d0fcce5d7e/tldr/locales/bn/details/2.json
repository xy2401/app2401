      "examples": [
        {
          "description": "একটি ফাইলকে `.zst` সাফিক্স সহ একটি নতুন ফাইলে কম্প্রেস করুন:",
          "command": "zstd {{ফাইল/এর/পাথ}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/zstd.md#L8"
        },
        {
          "description": "একটি ফাইল ডিকম্প্রেস করুন:",
          "command": "zstd {{[-d|--decompress]}} {{ফাইল.zst/এর/পাথ}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/zstd.md#L12"
        },
        {
          "description": "`stdout`-এ ডিকম্প্রেস করুন:",
          "command": "zstd {{[-d|--decompress]}} {{[-c|--stdout]}} {{ফাইল.zst/এর/পাথ}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.bn/common/zstd.md#L16"
