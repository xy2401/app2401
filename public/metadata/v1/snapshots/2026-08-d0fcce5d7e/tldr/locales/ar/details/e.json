      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "تشغيل `fzf` على جميع الملفات داخل المجلد المحدد:",
          "command": "find {{path/to/directory}} -type f | fzf",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/fzf.md#L9"
        },
        {
          "description": "تشغيل `fzf` للعمليات الجارية:",
          "command": "ps aux | fzf",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/fzf.md#L13"
        },
        {
          "description": "تحديد ملفات متعددة باستخدام `<Shift Tab>` وكتابتها إلى ملف:",
          "command": "find {{path/to/directory}} -type f | fzf {{[-m|--multi]}} > {{path/to/file}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/fzf.md#L17"
        },
        {
          "description": "تشغيل `fzf` مع نص بحثي محدد:",
          "command": "fzf {{[-q|--query]}} \"{{query}}\"",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/fzf.md#L21"
        },
        {
          "description": "تشغيل `fzf` على إدخالات تبدأ بـ `core` وتنتهي بـ `go` أو `rb` أو `py`:",
          "command": "fzf {{[-q|--query]}} \"^core go$ | rb$ | py$\"",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/fzf.md#L25"
        },
        {
          "description": "تشغيل `fzf` على إدخالات لا تطابق `pyc` وتحتوي على `travis`:",
          "command": "fzf {{[-q|--query]}} '!pyc travis'",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/fzf.md#L29"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/fzf.md"
    },
