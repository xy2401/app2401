      "id": "tldr--16ed77dea912",
      "canonicalPath": "common/chmod.md",
      "locale": "ar",
      "sourceLocale": "ar",
      "name": "chmod",
      "title": "chmod",
      "summary": "غير صلاحيات الوصول لملف أو مجلد.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "[u] امنح المستخدم مالك الملف صلاحية التنفيذ:",
          "command": "chmod u+x {{مسار/الملف}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L8"
        },
        {
          "description": "[u] امنح المستخدم صلاحيات القراءة والكتابة لملف أو مجلد:",
          "command": "chmod u+rw {{مسار/الملف_أو_المجلد}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L12"
        },
        {
          "description": "[g] أزل صلاحية التنفيذ من المجموعة:",
          "command": "chmod g-x {{مسار/الملف}}",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L16"
        },
        {
          "description": "[a] امنح جميع المستخدمين صلاحيات القراءة والتنفيذ:",
          "command": "chmod a+rx {{مسار/الملف}}",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L20"
        },
        {
          "description": "[o] امنح الآخرين (من خارج مجموعة مالك الملف) نفس صلاحيات المجموعة:",
          "command": "chmod o=g {{مسار/الملف}}",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L24"
        },
        {
          "description": "[o] أزل جميع الصلاحيات من الآخرين:",
          "command": "chmod o= {{مسار/الملف}}",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L28"
        },
        {
          "description": "[R] غير الصلاحيات بشكل متكرر لتمنح المجموعة والآخرين صلاحية الكتابة:",
          "command": "chmod {{[-R|--recursive]}} g+w,o+w {{مسار/المجلد}}",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L32"
        },
        {
          "description": "[R] امنح جميع المستخدمين صلاحية القراءة للملفات بشكل متكرر، وصلاحية التنفيذ للمجلدات الفرعية والملفات التي تملك صلاحية تنفيذ واحدة على الأقل:",
          "command": "chmod {{[-R|--recursive]}} a+rX {{مسار/المجلد}}",
          "line": 36,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md#L36"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/chmod.md"
    },
