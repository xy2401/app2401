    {
      "id": "tldr--66219ef97f0c",
      "canonicalPath": "common/yt-dlp.md",
      "locale": "ar",
      "sourceLocale": "ar",
      "name": "yt-dlp",
      "title": "yt-dlp",
      "summary": "تّفرع من youtube-dl مع ميزات إضافية وتحسينات. لتحميل الفيديوهات من Youtube ومواقع أخرى. انظر أيضًا: `ytfzf`.",
      "platform": "cross-platform",
      "softwareIds": [
        "yt-dlp--08eee2f0",
        "yt-dlp-master--b62b97df",
        "yt-dlp-nightly--44f25745"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "لتحميل فيديو أو قائمة تشغيل (مع الأعدادات الأفتراضية):",
          "command": "yt-dlp \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 10,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L10"
        },
        {
          "description": "عرض جميع الصيغ المتوفرة للتحميل من الفيديو:",
          "command": "yt-dlp {{[-F|--list-formats]}} \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 14,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L14"
        },
        {
          "description": "تحميل فيديو أو قائمة تشغيل بأفضل جودة MP4 متاح (الأفتراضي: \"bv\\*+ba/b\"):",
          "command": "yt-dlp {{[-f|--format]}} \"{{bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]}}\" \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 18,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L18"
        },
        {
          "description": "أستخراج الصوت فقط من الفيديو (يلزم توفر ffmpeg أو ffprobe):",
          "command": "yt-dlp {{[-x|--extract-audio]}} \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 22,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L22"
        },
        {
          "description": "لتحديد صيغة الصوت وجودته من الصوت المستخرج  (بين 0 (الأفضل) و 10 (الأسوء), الأفتراضي = 5):",
          "command": "yt-dlp {{[-x|--extract-audio]}} --audio-format {{mp3}} --audio-quality {{0}} \"{{https://www.youtube.com/watch?v=oHg5SJYRHA0}}\"",
          "line": 26,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L26"
        },
        {
          "description": "تحميل فقط العناصر الثانية والرابعة والخامسة والسادسة والأخيرة من قائمة التشغيل (مع العلم أنّ العنصر الأول يُحسب برقم 1، وليس 0):",
          "command": "yt-dlp {{[-I|--playlist-items]}} 2,4:6,-1 \"{{https://youtube.com/playlist?list=PLbzoR-pLrL6pTJfLQ3UwtB-3V4fimdqnA}}\"",
          "line": 30,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L30"
        },
        {
          "description": "تحميل كل قوائم التشغيل من قناة اليويتوب/المستخدم, مع حفظ كل قائمة تشغيل في مجلد منفصل:",
          "command": "yt-dlp {{[-o|--output]}} \"{{%(uploader)s/%(playlist)s/%(playlist_index)s - %(title)s.%(ext)s}}\" \"{{https://www.youtube.com/user/TheLinuxFoundation/playlists}}\"",
          "line": 34,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L34"
        },
        {
          "description": "تحميل دورة من Udemy مع حفظ كل فصل في مجلد منفصل:",
          "command": "yt-dlp {{[-u|--username]}} {{user}} {{[-p|--password]}} {{password}} {{[-P|--paths]}} \"{{path/to/directory}}\" {{[-o|--output]}} \"{{%(playlist)s/%(chapter_number)s - %(chapter)s/%(title)s.%(ext)s}}\" \"{{https://www.udemy.com/java-tutorial}}\"",
          "line": 38,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md#L38"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/yt-dlp.md"
    },
