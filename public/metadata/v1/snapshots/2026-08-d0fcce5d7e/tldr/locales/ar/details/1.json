      "exampleCount": 8,
      "examples": [
        {
          "description": "ترجمة ملف أو عدة ملفات مصدر إلى ملف تنفيذي:",
          "command": "g++ {{path/to/source1.cpp path/to/source2.cpp ...}} {{[-o|--output]}} {{path/to/output_executable}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/g%2B%2B.md#L9"
