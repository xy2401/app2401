      "id": "tldr--122367070ea8",
      "canonicalPath": "common/tail.md",
      "locale": "ar",
      "sourceLocale": "ar",
      "name": "tail",
      "title": "tail",
      "summary": "عرض الجزء الأخير من ملف. انظر أيضًا: `head`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "rktools2k3--c5a81681",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "عرض آخر 'عدد' من الأسطر في ملف:",
          "command": "tail {{[-n|--lines]}} {{count}} {{path/to/file}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tail.md#L9"
        },
        {
          "description": "طباعة محتوى ملف بدءًا من سطر معين:",
          "command": "tail {{[-n|--lines]}} +{{count}} {{path/to/file}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tail.md#L13"
        },
        {
          "description": "طباعة عدد معين من البايتات من نهاية ملف معين:",
          "command": "tail {{[-c|--bytes]}} {{count}} {{path/to/file}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tail.md#L17"
        },
        {
          "description": "طباعة آخر الأسطر من ملف معين والاستمرار في قراءته حتى الضغط على `<Ctrl c>`:",
          "command": "tail {{[-f|--follow]}} {{path/to/file}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tail.md#L21"
        },
        {
          "description": "الاستمرار في قراءة الملف حتى الضغط على `<Ctrl c>`، حتى لو كان غير متاح:",
          "command": "tail {{[-F|--retry --follow]}} {{path/to/file}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tail.md#L25"
        },
        {
          "description": "عرض آخر 'عدد' من الأسطر في 'ملف' وتحديث العرض كل 'عدد' من الثواني:",
          "command": "tail {{[-n|--lines]}} {{count}} {{[-s|--sleep-interval]}} {{seconds}} {{[-f|--follow]}} {{path/to/file}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tail.md#L29"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tail.md"
    },
