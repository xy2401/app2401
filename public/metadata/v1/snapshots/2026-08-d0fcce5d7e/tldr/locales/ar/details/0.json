    {
      "id": "tldr--03da635f46e2",
      "canonicalPath": "common/echo.md",
      "locale": "ar",
      "sourceLocale": "ar",
      "name": "echo",
      "title": "echo",
      "summary": "طباعة نص أو قيمة متغير في الـ terminal. انظر أيضًا: `printf`.",
      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "طباعة نص على الشاشة. ملاحظة: علامات الاقتباس اختيارية:",
          "command": "echo \"{{Hello World}}\"",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md#L9"
        },
        {
          "description": "طباعة نص يتضمن قيمة متغير بيئة:",
          "command": "echo \"{{My path is $PATH}}\"",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md#L13"
        },
        {
          "description": "طباعة نص دون إضافة سطر جديد في النهاية:",
          "command": "echo -n \"{{Hello World}}\"",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md#L17"
        },
        {
          "description": "إضافة نص إلى نهاية ملف:",
          "command": "echo \"{{Hello World}}\" >> {{file.txt}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md#L21"
        },
        {
          "description": "تفعيل تفسير الرموز الخاصة مثل `\\t` للجدولة و`\\n` للسطر الجديد:",
          "command": "echo -e \"{{Column 1\\tColumn 2}}\"",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md#L25"
        },
        {
          "description": "عرض رمز الخروج للأمر السابق (في Windows استخدم `echo %errorlevel%`، وفي PowerShell `$lastexitcode`):",
          "command": "echo $?",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md#L29"
        },
        {
          "description": "توجيه نص إلى مدخل برنامج آخر:",
          "command": "echo \"{{Hello World}}\" | {{program}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md#L33"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/echo.md"
    },
