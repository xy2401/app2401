      "softwareIds": [
        "lsof--6b34c281"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "العثور على العمليات التي فتحت ملفًا معينًا:",
          "command": "lsof {{path/to/file}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/lsof.md#L9"
        },
        {
          "description": "العثور على العملية التي فتحت منفذ إنترنت محدد:",
          "command": "lsof -i :{{port}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/lsof.md#L13"
        },
        {
          "description": "عرض معرف العملية (PID) فقط:",
          "command": "lsof -t {{path/to/file}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/lsof.md#L17"
        },
        {
          "description": "عرض الملفات المفتوحة بواسطة مستخدم معين:",
          "command": "lsof -u {{username}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/lsof.md#L21"
        },
        {
          "description": "عرض الملفات المفتوحة بواسطة أمر أو عملية معينة:",
          "command": "lsof -c {{process_or_command_name}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/lsof.md#L25"
        },
        {
          "description": "عرض الملفات المفتوحة بواسطة عملية معينة باستخدام PID:",
          "command": "lsof -p {{pid}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/lsof.md#L29"
        },
        {
          "description": "عرض الملفات المفتوحة داخل مُجَلَّد معين:",
          "command": "lsof +D {{path/to/directory}}",
          "line": 33,
