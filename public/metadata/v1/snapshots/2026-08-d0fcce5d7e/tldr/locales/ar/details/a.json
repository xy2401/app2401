      "canonicalPath": "linux/ss.md",
      "locale": "ar",
      "sourceLocale": "ar",
      "name": "ss",
      "title": "ss",
      "summary": "أداة للتحقيق في المقابس (Sockets) و المنافذ.",
      "platform": "linux",
      "softwareIds": [
        "simplyserial--fd883bf2"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "عرض جميع مقابس TCP/UDP/RAW/UNIX:",
          "command": "ss {{[-a|--all]}} {{--tcp|--udp|--raw|--unix}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/linux/ss.md#L8"
        },
        {
          "description": "تصفية مقابس TCP حسب الحالات، تضمين/استبعاد:",
          "command": "ss {{state|exclude}} {{bucket|big|connected|synchronized|...}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/linux/ss.md#L12"
        },
        {
          "description": "عرض جميع مقابس TCP المتصلة بمنفذ HTTPS المحلي (443):",
          "command": "ss {{[-t|--tcp]}} src :443",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/linux/ss.md#L16"
        },
        {
          "description": "عرض جميع مقابس TCP التي تستمع على المنفذ المحلي 8080:",
          "command": "ss {{[-lt|--listening --tcp]}} src :8080",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/linux/ss.md#L20"
        },
        {
          "description": "عرض جميع مقابس TCP مع العمليات المتصلة بمنفذ SSH الخارجي:",
          "command": "ss {{[-pt|--processes --tcp]}} dst :ssh",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/linux/ss.md#L24"
        },
        {
          "description": "عرض جميع مقابس UDP المتصلة بمنفذ مصدر ومنفذ وجهة محددين:",
          "command": "ss {{[-u|--udp]}} 'sport == :{{source_port}} and dport == :{{destination_port}}'",
