    {
      "id": "tldr--42489738ab06",
      "canonicalPath": "common/grep.md",
      "locale": "ar",
      "sourceLocale": "ar",
      "name": "grep",
      "title": "grep",
      "summary": "(`regex`) البحث عن أنماط في الملفات باستخدام التعابير النمطية. انظر أيضًا: `rg`, `regex`.",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "grep--aeeff087",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "البحث عن نمط داخل ملف:",
          "command": "grep \"{{search_pattern}}\" {{path/to/file}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L9"
        },
        {
          "description": "البحث عن سلسلة نصية مطابقة تمامًا (تعطيل التعابير النمطية):",
          "command": "grep {{[-F|--fixed-strings]}} \"{{exact_string}}\" {{path/to/file}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L13"
        },
        {
          "description": "البحث عن نمط في جميع الملفات داخل دليل بشكل متكرر، مع عرض أرقام الأسطر المطابقة، وتجاهل الملفات الثنائية:",
          "command": "grep {{[-rnI|--recursive --line-number --binary-files=without-match]}} \"{{search_pattern}}\" {{path/to/directory}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L17"
        },
        {
          "description": "استخدام التعابير النمطية الموسعة (يدعم `?`, `+`, `{}`, `()`, و `|`)، في وضع عدم التمييز بين الأحرف الكبيرة والصغيرة:",
          "command": "grep {{[-Ei|--extended-regexp --ignore-case]}} \"{{search_pattern}}\" {{path/to/file}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L21"
        },
        {
          "description": "طباعة 3 أسطر من السياق حول، قبل أو بعد كل تطابق:",
          "command": "grep {{--context|--before-context|--after-context}} 3 \"{{search_pattern}}\" {{path/to/file}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L25"
        },
        {
          "description": "طباعة اسم الملف ورقم السطر لكل تطابق مع تمييز بالألوان:",
          "command": "grep {{[-Hn|--with-filename --line-number]}} --color=always \"{{search_pattern}}\" {{path/to/file}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L29"
        },
        {
          "description": "البحث عن الأسطر المطابقة لنمط معين، مع طباعة النص المطابق فقط:",
          "command": "grep {{[-o|--only-matching]}} \"{{search_pattern}}\" {{path/to/file}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L33"
        },
        {
          "description": "البحث في `stdin` عن الأسطر التي لا تطابق النمط:",
          "command": "cat {{path/to/file}} | grep {{[-v|--invert-match]}} \"{{search_pattern}}\"",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/grep.md"
    },
