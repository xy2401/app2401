      "platform": "cross-platform",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 7,
      "examples": [
        {
          "description": "استبدال جميع تكرارات حرف معين في ملف وطباعة النتيجة:",
          "command": "tr < {{path/to/file}} {{find_character}} {{replace_character}}",
          "line": 8,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tr.md#L8"
        },
        {
          "description": "استبدال جميع تكرارات حرف معين من ناتج أمر آخر:",
          "command": "echo {{text}} | tr {{find_character}} {{replace_character}}",
          "line": 12,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tr.md#L12"
        },
        {
          "description": "تعيين كل حرف من المجموعة الأولى إلى الحرف المقابل في المجموعة الثانية:",
          "command": "tr < {{path/to/file}} '{{abcd}}' '{{jkmn}}'",
          "line": 16,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tr.md#L16"
        },
        {
          "description": "حذف جميع تكرارات مجموعة الأحرف المحددة من المدخلات:",
          "command": "tr < {{path/to/file}} {{[-d|--delete]}} '{{input_characters}}'",
          "line": 20,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tr.md#L20"
        },
        {
          "description": "ضغط سلسلة من الأحرف المتطابقة إلى حرف واحد:",
          "command": "tr < {{path/to/file}} {{[-s|--squeeze-repeats]}} '{{input_characters}}'",
          "line": 24,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tr.md#L24"
        },
        {
          "description": "تحويل محتويات ملف إلى أحرف كبيرة (Upper-case):",
          "command": "tr < {{path/to/file}} \"[:lower:]\" \"[:upper:]\"",
          "line": 28,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tr.md#L28"
        },
        {
          "description": "إزالة الأحرف غير القابلة للطباعة من ملف:",
          "command": "tr < {{path/to/file}} {{[-cd|--complement --delete]}} \"[:print:]\"",
          "line": 32,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ar/common/tr.md#L32"
        }
