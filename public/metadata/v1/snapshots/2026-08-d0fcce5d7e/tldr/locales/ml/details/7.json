    {
      "id": "tldr--f73ab5a1958b",
      "canonicalPath": "linux/cat.md",
      "locale": "ml",
      "sourceLocale": "ml",
      "name": "cat",
      "title": "cat",
      "summary": "ഫയലുകൾ പ്രിന്റ് ചെയ്യുവാനും സംയോജിപ്പിക്കുവാനുമുള്ള കമാൻഡ്. ഇതും കാണുക: `bat`.",
      "platform": "linux",
      "softwareIds": [
        "coreutils--1bc6b0b1",
        "gow--4cb149e7",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 6,
      "examples": [
        {
          "description": "ഫയലിന്റെ ഉള്ളടക്കം സ്റ്റാൻഡേർഡ് ഔട്പുട്ടിലേക്ക് പ്രിന്റ് ചെയ്യുവാൻ:",
          "command": "cat {{ഫയലിലേക്കുള്ള/പാത}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ml/linux/cat.md#L9"
        },
        {
          "description": "പല ഫയലുകൾ സംയോജിപ്പിച് ഒരു ഔട്ട്പുട്ട് ഫയലുണ്ടാക്കുവാൻ:",
          "command": "cat {{ഫയൽ1/ലേക്കുള്ള/പാത ഫയൽ2/ലേക്കുള്ള/പാത ...}} > {{ഔട്ട്പുട്ട്_ഫയൽ/ലേക്കുള്ള/പാത}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ml/linux/cat.md#L13"
        },
        {
          "description": "പല ഫയലുകൾ അപ്പെൻഡ് ചെയ്‌ത്‌ ഒരു ഔട്ട്പുട്ട് ഫയലുണ്ടാക്കുവാൻ:",
          "command": "cat {{ഫയൽ1/ലേക്കുള്ള/പാത ഫയൽ2/ലേക്കുള്ള/പാത ...}} >> {{ഔട്ട്പുട്ട്_ഫയൽ/ലേക്കുള്ള/പാത}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.ml/linux/cat.md#L17"
        },
