    {
      "id": "tldr--9994d749dd63",
      "canonicalPath": "common/sed.md",
      "locale": "da",
      "sourceLocale": "da",
      "name": "sed",
      "title": "sed",
      "summary": "Rediger tekst, programmatisk. Se også: `awk`, `ed`.",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "sed--b7784a86",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Erstat den første forekomst af et regulært udtryk (`regex`) i hver linje af en fil, og print resultatet:",
          "command": "sed 's/{{regular_expression}}/{{erstat}}/' {{filnavn}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L9"
        },
        {
          "description": "Erstat alle forekomster af et regulært udtryk in en fil, og print resultatet:",
          "command": "sed -r 's/{{regular_expression}}/{{erstat}}/g' {{filnavn}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L13"
        },
        {
          "description": "Erstat alle forekomster af en streng i en fil, og overskriv filen:",
          "command": "sed -i 's/{{find}}/{{erstat}}/g' {{filnavn}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L17"
        },
        {
          "description": "Erstat forekomster på linjer der matcher mønstret:",
          "command": "sed '/{{linje_mønster}}/s/{{find}}/{{erstat}}/' {{filnavn}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L21"
        },
        {
          "description": "Fjern linjer der matcher mønstret:",
          "command": "sed '/{{linje_mønster}}/d' {{filnavn}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L25"
        },
        {
          "description": "Print de første 11 linjer af en fil:",
          "command": "sed 11q {{filnavn}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L29"
        },
        {
          "description": "Udfør flere find-og-erstat udtryk i en fil:",
          "command": "sed -e 's/{{find}}/{{erstat}}/' -e 's/{{find}}/{{erstat}}/' {{filnavn}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L33"
        },
        {
          "description": "Erstat separator `/` med en hvilken som helst anden karakter ikke brugt i find- eller erstat-mønstrene, f.eks. `#`:",
          "command": "sed 's#{{find}}#{{erstat}}#' {{filnavn}}",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/sed.md"
    },
