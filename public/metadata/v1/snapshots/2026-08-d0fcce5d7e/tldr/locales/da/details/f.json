    {
      "id": "tldr--42489738ab06",
      "canonicalPath": "common/grep.md",
      "locale": "da",
      "sourceLocale": "da",
      "name": "grep",
      "title": "grep",
      "summary": "Find mønstre i filer via regulære udtryk (`regex`). Se også: `rg`, `regex`.",
      "platform": "cross-platform",
      "softwareIds": [
        "gow--4cb149e7",
        "grep--aeeff087",
        "microsoft-coreutils--3ec6ee3f",
        "unxutils--5bef4004"
      ],
      "candidateSoftwareIds": [],
      "exampleCount": 8,
      "examples": [
        {
          "description": "Søg efter et mønster i en fil:",
          "command": "grep \"{{søgemønster}}\" {{sti/til/fil}}",
          "line": 9,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L9"
        },
        {
          "description": "Søg efter en eksakt streng (deaktiverer regulære udtryk):",
          "command": "grep {{[-F|--fixed-strings]}} \"{{eksakt_streng}}\" {{sti/til/fil}}",
          "line": 13,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L13"
        },
        {
          "description": "Søg efter et mønster i alle filer, pånær binære, rekursivt i en mappe. Vis linjenumre der matcher til mønstret:",
          "command": "grep {{[-rnI|--recursive --line-number --binary-files=without-match]}} \"{{søgemønster}}\" {{sti/til/mappe}}",
          "line": 17,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L17"
        },
        {
          "description": "Brug udvidede regulære udtryk (understøtter `?`, `+`, `{}`, `()`, og `|`), i case-insensitive modus:",
          "command": "grep {{[-Ei|--extended-regexp --ignore-case]}} \"{{søgemønster}}\" {{sti/til/fil}}",
          "line": 21,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L21"
        },
        {
          "description": "Print 3 linjer af kontekst omkring, før eller efter hvert match:",
          "command": "grep {{--context|--before-context|--after-context}} 3 \"{{søgemønster}}\" {{sti/til/fil}}",
          "line": 25,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L25"
        },
        {
          "description": "Print, filnavn og linjenummer for hvert match, med farveoutput:",
          "command": "grep {{[-Hn|--with-filename --line-number]}} --color=always \"{{søgemønster}}\" {{sti/til/fil}}",
          "line": 29,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L29"
        },
        {
          "description": "Søg efter linjer som matcher et mønster. Print kun den matchende tekst:",
          "command": "grep {{[-o|--only-matching]}} \"{{søgemønster}}\" {{sti/til/fil}}",
          "line": 33,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L33"
        },
        {
          "description": "Søg i `stdin` efter linjer der ikke matcher et mønster:",
          "command": "cat {{sti/til/fil}} | grep {{[-v|--invert-match]}} \"{{søgemønster}}\"",
          "line": 37,
          "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md#L37"
        }
      ],
      "sourceRef": "https://github.com/tldr-pages/tldr/blob/b64c941c148686ccc00173f7ebb7dc599eeba525/pages.da/common/grep.md"
    },
